'use client';

import { useState } from 'react';
import { ROUTES } from '@/constants/routes';

import { Heading } from '@/components/layout/heading';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Checkbox } from '@/components/ui/checkbox';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover';
import { Calendar } from '@/components/ui/calendar';
import { FormError, Label } from '@/components/ui/extension/field';
import { useForm } from 'react-hook-form';
import { CalendarIcon, FileText, X, Search, RefreshCw } from 'lucide-react';
import { format } from 'date-fns';

type RelievingLetterFormData = {
    departments: string[];
    designations: string[];
    fromDate: Date;
    toDate: Date;
};

const departmentOptions = [
    'IT Education',
    'Sales and Marketing',
    'Human Resources',
    'Finance',
    'Operations',
    'Customer Support',
    'Research and Development'
];

const designationOptions = [
    'E-learning coordinator',
    'Client Acquisition',
    'Assistant Business Development Manager',
    'Telecaller Executive',
    'Software Developer',
    'Senior Software Developer',
    'Team Lead',
    'Manager',
    'Director',
    'CEO'
];

export default function RelievingLetterPage() {
    const [departmentDropdownOpen, setDepartmentDropdownOpen] = useState(false);
    const [designationDropdownOpen, setDesignationDropdownOpen] = useState(false);
    const [fromDateOpen, setFromDateOpen] = useState(false);
    const [toDateOpen, setToDateOpen] = useState(false);

    const {
        register,
        handleSubmit,
        setValue,
        watch,
        formState: { errors, isSubmitting }
    } = useForm<RelievingLetterFormData>({
        defaultValues: {
            departments: ['ALL'],
            designations: ['ALL'],
            fromDate: new Date('2018-01-01'),
            toDate: new Date('2018-01-31')
        }
    });

    const watchedDepartments = watch('departments');
    const watchedDesignations = watch('designations');
    const watchedFromDate = watch('fromDate');
    const watchedToDate = watch('toDate');

    const handleDepartmentToggle = (dept: string) => {
        const current = watchedDepartments || [];
        if (dept === 'ALL') {
            setValue('departments', ['ALL']);
        } else {
            const newSelection = current.includes(dept)
                ? current.filter(d => d !== dept && d !== 'ALL')
                : [...current.filter(d => d !== 'ALL'), dept];
            setValue('departments', newSelection.length === 0 ? ['ALL'] : newSelection);
        }
    };

    const handleDesignationToggle = (desig: string) => {
        const current = watchedDesignations || [];
        if (desig === 'ALL') {
            setValue('designations', ['ALL']);
        } else {
            const newSelection = current.includes(desig)
                ? current.filter(d => d !== desig && d !== 'ALL')
                : [...current.filter(d => d !== 'ALL'), desig];
            setValue('designations', newSelection.length === 0 ? ['ALL'] : newSelection);
        }
    };

    const onSubmit = (data: RelievingLetterFormData) => {
        console.log('Relieving letter filters:', data);
        // Handle relieving letter generation
    };

    const getDisplayText = (items: string[], allText: string) => {
        if (items.includes('ALL') || items.length === 0) return allText;
        return items.length === 1 ? items[0] : `${items.length} selected`;
    };

    return (
        <div className="min-h-screen">
            <div className="container p-1 space-y-6">
                {/* Header */}
                <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div className="space-y-1">
                        <Heading
                            title="Employee Relieving Letter"
                            description="Generate relieving letters for employees with advanced filtering options"
                        />
                    </div>
                </div>

                {/* Relieving Letter Form Section */}
                <Card className="shadow-lg">
                    <CardHeader>
                        <CardTitle className="text-lg font-semibold">
                            Employee Relieving Letter
                        </CardTitle>
                    </CardHeader>
                    <CardContent>
                        <form onSubmit={handleSubmit(onSubmit)} className="space-y-6">
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                {/* Department Filter */}
                                <div className="space-y-2">
                                    <Label>
                                        Department <span className="text-red-500">*</span>
                                    </Label>
                                    <Popover open={departmentDropdownOpen} onOpenChange={setDepartmentDropdownOpen}>
                                        <PopoverTrigger asChild>
                                            <Button
                                                variant="outline"
                                                className="w-full justify-between text-left font-normal"
                                            >
                                                <span className="truncate">
                                                    {getDisplayText(watchedDepartments, 'All Departments')}
                                                </span>
                                                <Search className="h-4 w-4 opacity-50" />
                                            </Button>
                                        </PopoverTrigger>
                                        <PopoverContent className="w-80 p-0" align="start">
                                            <div className="p-3">
                                                <Input
                                                    placeholder="search here..."
                                                    className="mb-3"
                                                />
                                                <div className="space-y-2 max-h-60 overflow-y-auto">
                                                    {['ALL', ...departmentOptions].map((dept) => (
                                                        <div key={dept} className="flex items-center space-x-2">
                                                            <Checkbox
                                                                id={`dept-${dept}`}
                                                                checked={watchedDepartments?.includes(dept) || false}
                                                                onCheckedChange={() => handleDepartmentToggle(dept)}
                                                            />
                                                            <label
                                                                htmlFor={`dept-${dept}`}
                                                                className="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
                                                            >
                                                                {dept}
                                                            </label>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        </PopoverContent>
                                    </Popover>
                                </div>

                                {/* Designation Filter */}
                                <div className="space-y-2">
                                    <Label>
                                        Designation <span className="text-red-500">*</span>
                                    </Label>
                                    <Popover open={designationDropdownOpen} onOpenChange={setDesignationDropdownOpen}>
                                        <PopoverTrigger asChild>
                                            <Button
                                                variant="outline"
                                                className="w-full justify-between text-left font-normal"
                                            >
                                                <span className="truncate">
                                                    {getDisplayText(watchedDesignations, 'All Designations')}
                                                </span>
                                                <Search className="h-4 w-4 opacity-50" />
                                            </Button>
                                        </PopoverTrigger>
                                        <PopoverContent className="w-80 p-0" align="start">
                                            <div className="p-3">
                                                <Input
                                                    placeholder="search here..."
                                                    className="mb-3"
                                                />
                                                <div className="space-y-2 max-h-60 overflow-y-auto">
                                                    {['ALL', ...designationOptions].map((desig) => (
                                                        <div key={desig} className="flex items-center space-x-2">
                                                            <Checkbox
                                                                id={`desig-${desig}`}
                                                                checked={watchedDesignations?.includes(desig) || false}
                                                                onCheckedChange={() => handleDesignationToggle(desig)}
                                                            />
                                                            <label
                                                                htmlFor={`desig-${desig}`}
                                                                className="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
                                                            >
                                                                {desig}
                                                            </label>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        </PopoverContent>
                                    </Popover>
                                </div>

                                {/* From Date */}
                                <div className="space-y-2">
                                    <Label>
                                        From Date
                                    </Label>
                                    <Popover open={fromDateOpen} onOpenChange={setFromDateOpen}>
                                        <PopoverTrigger asChild>
                                            <Button
                                                variant="outline"
                                                className="w-full justify-start text-left font-normal"
                                            >
                                                <CalendarIcon className="mr-2 h-4 w-4" />
                                                {watchedFromDate ? format(watchedFromDate, 'dd-MM-yyyy') : 'Select date'}
                                            </Button>
                                        </PopoverTrigger>
                                        <PopoverContent className="w-auto p-0" align="start">
                                            <Calendar
                                                mode="single"
                                                selected={watchedFromDate}
                                                onSelect={(date) => {
                                                    if (date) {
                                                        setValue('fromDate', date);
                                                        setFromDateOpen(false);
                                                    }
                                                }}
                                                initialFocus
                                            />
                                        </PopoverContent>
                                    </Popover>
                                </div>

                                {/* To Date */}
                                <div className="space-y-2">
                                    <Label>
                                        To Date
                                    </Label>
                                    <Popover open={toDateOpen} onOpenChange={setToDateOpen}>
                                        <PopoverTrigger asChild>
                                            <Button
                                                variant="outline"
                                                className="w-full justify-start text-left font-normal"
                                            >
                                                <CalendarIcon className="mr-2 h-4 w-4" />
                                                {watchedToDate ? format(watchedToDate, 'dd-MM-yyyy') : 'Select date'}
                                            </Button>
                                        </PopoverTrigger>
                                        <PopoverContent className="w-auto p-0" align="start">
                                            <Calendar
                                                mode="single"
                                                selected={watchedToDate}
                                                onSelect={(date) => {
                                                    if (date) {
                                                        setValue('toDate', date);
                                                        setToDateOpen(false);
                                                    }
                                                }}
                                                initialFocus
                                            />
                                        </PopoverContent>
                                    </Popover>
                                </div>
                            </div>

                            {/* Action Buttons */}
                            <div className="flex flex-col gap-3 border-t pt-4 sm:flex-row sm:justify-end">
                                <Button
                                    type="button"
                                    variant="outline"
                                    onClick={() => {
                                        setValue('departments', ['ALL']);
                                        setValue('designations', ['ALL']);
                                        setValue('fromDate', new Date('2018-01-01'));
                                        setValue('toDate', new Date('2018-01-31'));
                                    }}
                                    disabled={isSubmitting}
                                    className="order-2 sm:order-1 transition-all duration-200 hover:scale-105 w-fit"
                                >
                                    Cancel
                                </Button>
                                <Button
                                    type="submit"
                                    disabled={isSubmitting}
                                    className="order-1 sm:order-2 transition-all duration-200 hover:scale-105 w-fit"
                                >
                                    {isSubmitting ? (
                                        <div className="flex items-center">
                                            <RefreshCw className="mr-2 h-4 w-4 animate-spin" />
                                            Generating...
                                        </div>
                                    ) : (
                                        <div className="flex items-center">
                                            <FileText className="mr-2 h-4 w-4" />
                                            Generate Report
                                        </div>
                                    )}
                                </Button>
                            </div>
                        </form>
                    </CardContent>
                </Card>
            </div>
        </div>
    );
}
