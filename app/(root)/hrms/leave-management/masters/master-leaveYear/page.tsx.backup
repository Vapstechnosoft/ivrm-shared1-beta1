'use client';

import { Heading } from '@/components/layout/heading';
import { Button } from '@/components/ui/button';
import { CollapsibleSection } from '@/components/ui/form/collapsible-section';
import { DataTable } from '@/components/ui/data-table/data-table';
import { InputText } from '@/components/ui/extension/input-text';
import { Checkbox } from '@/components/ui/checkbox';
import { createLocalCrud, type BaseEntity } from '@/lib/localdb';
import { toast } from 'sonner';
import { Edit, Trash2, Plus } from 'lucide-react';
import React, { useEffect, useMemo, useState } from 'react';
import { useForm } from 'react-hook-form';

interface LeaveYear extends BaseEntity {
  leaveYear: string;
  fromDate: string;
  toDate: string;
  isActive: boolean;
}

const leaveYearDB = createLocalCrud<LeaveYear>('leaveYear');

export default function MasterLeaveYearPage() {
  const [data, setData] = useState<LeaveYear[]>([]);
  const [isFormOpen, setIsFormOpen] = useState(false);
  const [editingLeaveYear, setEditingLeaveYear] = useState<LeaveYear | null>(null);

  const { register, handleSubmit, reset, setValue, watch, formState: { errors } } = useForm<LeaveYear>({
    defaultValues: {
      leaveYear: '',
      fromDate: '',
      toDate: '',
      isActive: true
    }
  });

  const loadData = () => {
    try {
      const result = leaveYearDB.list();
      setData(result);
    } catch (error) {
      console.error('Error loading leave years:', error);
      toast.error('Failed to load leave years');
    }
  };

  useEffect(() => {
    loadData();
  }, []);

  const handleAddClick = () => {
    setIsFormOpen(true);
    setEditingLeaveYear(null);
    reset({
      leaveYear: '',
      fromDate: '',
      toDate: '',
      isActive: true
    });
    // Scroll to form
    setTimeout(() => {
      const formElement = document.getElementById('leave-year-form');
      if (formElement) {
        formElement.scrollIntoView({ behavior: 'smooth' });
      }
    }, 100);
  };

  const handleFormClose = () => {
    setIsFormOpen(false);
    setEditingLeaveYear(null);
    reset({
      leaveYear: '',
      fromDate: '',
      toDate: '',
      isActive: true
    });
  };

  const onSubmit = (formData: LeaveYear) => {
    try {
      if (editingLeaveYear) {
        leaveYearDB.update(editingLeaveYear.id, formData);
        toast.success('Leave year updated successfully');
      } else {
        leaveYearDB.create(formData);
        toast.success('Leave year created successfully');
      }
      loadData();
      handleFormClose();
    } catch (error) {
      console.error('Error saving leave year:', error);
      toast.error('Failed to save leave year');
    }
  };

  const handleEdit = (leaveYear: LeaveYear) => {
    setEditingLeaveYear(leaveYear);
    setIsFormOpen(true);
    setValue('leaveYear', leaveYear.leaveYear);
    setValue('fromDate', leaveYear.fromDate);
    setValue('toDate', leaveYear.toDate);
    setValue('isActive', leaveYear.isActive);
    // Scroll to form
    setTimeout(() => {
      const formElement = document.getElementById('leave-year-form');
      if (formElement) {
        formElement.scrollIntoView({ behavior: 'smooth' });
      }
    }, 100);
  };

  const handleDelete = (id: number) => {
    if (window.confirm('Are you sure you want to delete this leave year?')) {
      try {
        leaveYearDB.remove(id);
        toast.success('Leave year deleted successfully');
        loadData();
      } catch (error) {
        console.error('Error deleting leave year:', error);
        toast.error('Failed to delete leave year');
      }
    }
  };

  const handleClear = () => {
    handleFormClose();
  };

  const columns = useMemo(() => [
    {
      accessorKey: 'leaveYear',
      header: 'Leave Year',
    },
    {
      accessorKey: 'fromDate',
      header: 'From Date',
    },
    {
      accessorKey: 'toDate',
      header: 'To Date',
    },
    {
      accessorKey: 'isActive',
      header: 'Status',
      cell: ({ row }: { row: any }) => (
        <span className={row.original.isActive ? 'text-green-600' : 'text-red-600'}>
          {row.original.isActive ? 'Active' : 'Inactive'}
        </span>
      ),
    },
    {
      id: 'actions',
      header: 'Actions',
      cell: ({ row }: { row: any }) => (
        <div className="flex gap-2">
          <Button
            variant="outline"
            size="sm"
            onClick={() => handleEdit(row.original)}
          >
            <Edit className="h-4 w-4" />
          </Button>
          <Button
            variant="outline"
            size="sm"
            onClick={() => handleDelete(row.original.id)}
          >
            <Trash2 className="h-4 w-4" />
          </Button>
        </div>
      ),
    },
  ], []);

  return (
    <div className='min-h-screen'>
      <div className='container p-1 space-y-4'>
        <div className='flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'>
          <div className='space-y-1'>
            <Heading title='Leave Management' description='Master Leave Year Management' />
          </div>
          <Button onClick={handleAddClick} className='bg-blue-600 hover:bg-blue-700'>
            <Plus className='h-4 w-4 mr-2' />
            Add Leave Year
          </Button>
        </div>

        {/* Table Section */}
        <CollapsibleSection title='Master Leave Year Details' description='' defaultOpen={true} variant='default' size='lg' className='shadow-lg transition-shadow duration-300 hover:shadow-xl'>
          <DataTable
            data={data}
            columns={columns}
            totalItems={data.length}
          />
        </CollapsibleSection>

        {/* Form Section */}
        {isFormOpen && (
          <div id="leave-year-form">
            <CollapsibleSection 
              title={editingLeaveYear ? 'Edit Leave Year' : 'Add Leave Year'} 
              description='' 
              defaultOpen={true} 
              variant='default' 
              size='lg' 
              className='shadow-lg transition-shadow duration-300 hover:shadow-xl'
            >
              <form onSubmit={handleSubmit(onSubmit)} className='space-y-4'>
                <div className='grid grid-cols-1 md:grid-cols-3 gap-4'>
                  <div>
                    <label className='text-sm font-medium'>Leave Year *</label>
                    <InputText
                      {...register('leaveYear', { required: 'Leave year is required' })}
                      placeholder='Enter leave year'
                      className={errors.leaveYear ? 'border-red-500' : ''}
                    />
                    {errors.leaveYear && (
                      <p className='text-red-500 text-xs mt-1'>{errors.leaveYear.message}</p>
                    )}
                  </div>

                  <div>
                    <label className='text-sm font-medium'>From Date *</label>
                    <InputText
                      type='date'
                      {...register('fromDate', { required: 'From date is required' })}
                      className={errors.fromDate ? 'border-red-500' : ''}
                    />
                    {errors.fromDate && (
                      <p className='text-red-500 text-xs mt-1'>{errors.fromDate.message}</p>
                    )}
                  </div>

                  <div>
                    <label className='text-sm font-medium'>To Date *</label>
                    <InputText
                      type='date'
                      {...register('toDate', { required: 'To date is required' })}
                      className={errors.toDate ? 'border-red-500' : ''}
                    />
                    {errors.toDate && (
                      <p className='text-red-500 text-xs mt-1'>{errors.toDate.message}</p>
                    )}
                  </div>
                </div>

                <div className='flex items-center space-x-2'>
                  <Checkbox
                    id="isActive"
                    checked={watch('isActive')}
                    onCheckedChange={(checked) => setValue('isActive', checked as boolean)}
                  />
                  <label htmlFor="isActive" className='text-sm font-medium'>
                    Active
                  </label>
                </div>

                <div className='flex gap-2'>
                  <Button type='submit' className='bg-blue-600 hover:bg-blue-700'>
                    {editingLeaveYear ? 'Update' : 'Save'}
                  </Button>
                  <Button type='button' variant='outline' onClick={handleClear}>
                    Cancel
                  </Button>
                </div>
              </form>
            </CollapsibleSection>
          </div>
        )}
      </div>
    </div>
  );
}
