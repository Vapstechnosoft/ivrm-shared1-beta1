"use client";

import { Heading } from "@/components/layout/heading";
import { Button } from "@/components/ui/button";
import { CollapsibleSection } from "@/components/ui/form/collapsible-section";
import { DataTable } from "@/components/ui/data-table/data-table";
import { InputText } from "@/components/ui/extension/input-text";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Checkbox } from "@/components/ui/checkbox";
import { createLocalCrud, type BaseEntity } from '@/lib/localdb';
import { toast } from "sonner";
import { Edit, Trash2, Plus, X, Search } from "lucide-react";
import React, { useEffect, useMemo, useState } from "react";
import { useForm } from "react-hook-form";

interface LeaveAuthorization extends BaseEntity {
  institution: string;
  gradeName: string;
  groupTypeName: string;
  departmentName: string;
  designationName: string;
  leaveType: string;
  orderOfApproval: string;
  approvalPerson: string;
  finalFlag: boolean;
  emailId: string;
  sanctionedUser: string;
  sanctionedOrder: string;
}

const leaveAuthDB = createLocalCrud<LeaveAuthorization>("leaveAuthorization");

export default function LeaveAuthorizationPage() {
  const [data, setData] = useState<LeaveAuthorization[]>([]);
  const [isFormOpen, setIsFormOpen] = useState(false);
  const [editingAuth, setEditingAuth] = useState<LeaveAuthorization | null>(
    null
  );
  const [searchTerm, setSearchTerm] = useState("");
  const [filteredData, setFilteredData] = useState<LeaveAuthorization[]>([]);

  const {
    register,
    handleSubmit,
    reset,
    setValue,
    watch,
    formState: { errors },
  } = useForm<LeaveAuthorization>({
    defaultValues: {
      institution: "Vaps Knowledge Services Pvt Ltd",
      gradeName: "",
      groupTypeName: "",
      departmentName: "",
      designationName: "",
      leaveType: "",
      orderOfApproval: "",
      approvalPerson: "",
      finalFlag: false,
      emailId: "",
      sanctionedUser: "",
      sanctionedOrder: "",
    },
  });

  const loadData = () => {
    try {
      const result = leaveAuthDB.list();
      setData(result);
      setFilteredData(result);
    } catch (error) {
      console.error("Error loading leave authorizations:", error);
      toast.error("Failed to load leave authorizations");
    }
  };

  useEffect(() => {
    loadData();

    // Add sample data if no data exists
    const existingData = leaveAuthDB.list();
    if (existingData.length === 0) {
      const sampleData: Omit<LeaveAuthorization, "id" | "createdAt">[] = [
        {
          institution: "Vaps Knowledge Services Pvt Ltd",
          gradeName: "Manager",
          groupTypeName: "VKS",
          departmentName: "Sales and Marketing",
          designationName: "Assistant Business Development Manager",
          leaveType: "Comp Off",
          orderOfApproval: "1",
          approvalPerson: "Benoy Yogesh Shetty",
          finalFlag: false,
          emailId: "benoy@vaps.com",
          sanctionedUser: "Benoy Yogesh Shetty",
          sanctionedOrder: "1",
        },
        {
          institution: "Vaps Knowledge Services Pvt Ltd",
          gradeName: "Manager",
          groupTypeName: "VKS",
          departmentName: "Sales and Marketing",
          designationName: "Assistant Business Development Manager",
          leaveType: "Optional Leave",
          orderOfApproval: "1",
          approvalPerson: "Benoy Yogesh Shetty",
          finalFlag: false,
          emailId: "benoy@vaps.com",
          sanctionedUser: "Benoy Yogesh Shetty",
          sanctionedOrder: "1",
        },
        {
          institution: "Vaps Knowledge Services Pvt Ltd",
          gradeName: "Manager",
          groupTypeName: "VKS",
          departmentName: "Sales and Marketing",
          designationName: "Assistant Business Development Manager",
          leaveType: "Optional Leave",
          orderOfApproval: "1",
          approvalPerson: "Benoy Yogesh Shetty",
          finalFlag: false,
          emailId: "benoy@vaps.com",
          sanctionedUser: "Benoy Yogesh Shetty",
          sanctionedOrder: "1",
        },
      ];

      sampleData.forEach((data) => leaveAuthDB.create(data));
      loadData();
    }
  }, []);

  // Filter data based on search term
  useEffect(() => {
    if (!searchTerm) {
      setFilteredData(data);
    } else {
      const filtered = data.filter(
        (item) =>
          item.gradeName.toLowerCase().includes(searchTerm.toLowerCase()) ||
          item.departmentName
            .toLowerCase()
            .includes(searchTerm.toLowerCase()) ||
          item.designationName
            .toLowerCase()
            .includes(searchTerm.toLowerCase()) ||
          item.groupTypeName.toLowerCase().includes(searchTerm.toLowerCase()) ||
          item.leaveType.toLowerCase().includes(searchTerm.toLowerCase()) ||
          item.emailId.toLowerCase().includes(searchTerm.toLowerCase()) ||
          item.sanctionedUser
            .toLowerCase()
            .includes(searchTerm.toLowerCase()) ||
          item.sanctionedOrder.toLowerCase().includes(searchTerm.toLowerCase())
      );
      setFilteredData(filtered);
    }
  }, [searchTerm, data]);

  const handleAddClick = () => {
    setIsFormOpen(true);
    setEditingAuth(null);
    reset({
      institution: "Vaps Knowledge Services Pvt Ltd",
      gradeName: "",
      groupTypeName: "",
      departmentName: "",
      designationName: "",
      leaveType: "",
      orderOfApproval: "",
      approvalPerson: "",
      finalFlag: false,
      emailId: "",
      sanctionedUser: "",
      sanctionedOrder: "",
    });
    // Scroll to form
    setTimeout(() => {
      const formElement = document.getElementById("leave-auth-form");
      if (formElement) {
        formElement.scrollIntoView({ behavior: "smooth" });
      }
    }, 100);
  };

  const handleFormClose = () => {
    setIsFormOpen(false);
    setEditingAuth(null);
    reset({
      institution: "Vaps Knowledge Services Pvt Ltd",
      gradeName: "",
      groupTypeName: "",
      departmentName: "",
      designationName: "",
      leaveType: "",
      orderOfApproval: "",
      approvalPerson: "",
      finalFlag: false,
      emailId: "",
      sanctionedUser: "",
      sanctionedOrder: "",
    });
  };

  const onSubmit = (formData: LeaveAuthorization) => {
    try {
      if (editingAuth) {
        leaveAuthDB.update(editingAuth.id, formData);
        toast.success("Leave authorization updated successfully");
      } else {
        leaveAuthDB.create(formData);
        toast.success("Leave authorization created successfully");
      }
      loadData();
      handleFormClose();
    } catch (error) {
      console.error("Error saving leave authorization:", error);
      toast.error("Failed to save leave authorization");
    }
  };

  const handleEdit = (auth: LeaveAuthorization) => {
    setEditingAuth(auth);
    setIsFormOpen(true);
    setValue("institution", auth.institution);
    setValue("gradeName", auth.gradeName);
    setValue("groupTypeName", auth.groupTypeName);
    setValue("departmentName", auth.departmentName);
    setValue("designationName", auth.designationName);
    setValue("leaveType", auth.leaveType);
    setValue("orderOfApproval", auth.orderOfApproval);
    setValue("approvalPerson", auth.approvalPerson);
    setValue("finalFlag", auth.finalFlag);
    setValue("emailId", auth.emailId);
    setValue("sanctionedUser", auth.sanctionedUser);
    setValue("sanctionedOrder", auth.sanctionedOrder);
    // Scroll to form
    setTimeout(() => {
      const formElement = document.getElementById("leave-auth-form");
      if (formElement) {
        formElement.scrollIntoView({ behavior: "smooth" });
      }
    }, 100);
  };

  const handleDelete = (id: number) => {
    if (
      window.confirm(
        "Are you sure you want to delete this leave authorization?"
      )
    ) {
      try {
        leaveAuthDB.remove(id);
        toast.success("Leave authorization deleted successfully");
        loadData();
      } catch (error) {
        console.error("Error deleting leave authorization:", error);
        toast.error("Failed to delete leave authorization");
      }
    }
  };

  const handleClear = () => {
    handleFormClose();
  };

  const columns = useMemo(
    () => [
      {
        accessorKey: "id",
        header: "SL.No",
        cell: ({ row }: { row: any }) => (
          <div className="text-center">{row.index + 1}</div>
        ),
      },
      {
        accessorKey: "gradeName",
        header: "Grade Name",
      },
      {
        accessorKey: "departmentName",
        header: "Department Name",
      },
      {
        accessorKey: "designationName",
        header: "Designation Name",
      },
      {
        accessorKey: "groupTypeName",
        header: "Group Type Name",
      },
      {
        accessorKey: "leaveType",
        header: "Leave Type",
      },
      {
        accessorKey: "emailId",
        header: "Email Id",
      },
      {
        accessorKey: "sanctionedUser",
        header: "Sanctioned User",
      },
      {
        accessorKey: "sanctionedOrder",
        header: "Sanctioned Order",
      },
      {
        accessorKey: "finalFlag",
        header: "Final Flag",
        cell: ({ row }: { row: any }) => (
          <div className="flex justify-center">
            {row.original.finalFlag ? (
              <span className="text-green-600">✓</span>
            ) : (
              <X className="h-4 w-4 text-red-600" />
            )}
          </div>
        ),
      },
      {
        id: "actions",
        header: "Action",
        cell: ({ row }: { row: any }) => (
          <div className="flex gap-2">
            <Button
              variant="outline"
              size="sm"
              onClick={() => handleEdit(row.original)}
            >
              <Edit className="h-4 w-4" />
            </Button>
            <Button
              variant="outline"
              size="sm"
              onClick={() => handleDelete(row.original.id)}
            >
              <Trash2 className="h-4 w-4" />
            </Button>
          </div>
        ),
      },
    ],
    []
  );

  return (
    <div className="min-h-screen bg-gray-50">
      <div className="container mx-auto p-6 space-y-6">
        {/* Header Section */}
        <div className="bg-white rounded-lg shadow-sm p-6">
          <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div className="space-y-2">
              <h1 className="text-2xl font-bold text-gray-900">
                LEAVE MANAGEMENT
              </h1>
              <div className="flex items-center space-x-2 text-sm text-gray-600">
                <span>Master</span>
                <span>&gt;</span>
                <span className="text-primary font-medium">
                  Leave Authorization
                </span>
              </div>
            </div>
          </div>

          {/* Tab Section */}
          <div className="mt-6 border-b border-gray-200">
            <div className="flex space-x-8">
              <button className="py-2 px-1 border-b-2 border-red-500 text-red-600 font-medium text-sm">
                LEAVE AUTHORIZATION
              </button>
            </div>
          </div>
        </div>

        {/* Form Section */}
        <div className="bg-white rounded-lg shadow-sm p-6">
          <h2 className="text-lg font-semibold text-gray-900 mb-4">
            Leave Authorization
          </h2>

          <form onSubmit={handleSubmit(onSubmit)} className="space-y-6">
            {/* Institution Field */}
            <div className="mb-4">
              <label className="block text-sm font-medium text-gray-700 mb-2">
                Institution
              </label>
              <div className="bg-gray-100 p-3 rounded-md text-gray-600">
                {watch("institution")}
              </div>
            </div>

            {/* Form Fields Grid */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              {/* Left Column */}
              <div className="space-y-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">
                    Select Grade <span className="text-red-500">*</span>
                  </label>
                  <Select
                    value={watch("gradeName")}
                    onValueChange={(value) => setValue("gradeName", value)}
                  >
                    <SelectTrigger
                      className={errors.gradeName ? "border-red-500" : ""}
                    >
                      <SelectValue placeholder="--Select--" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="Manager">Manager</SelectItem>
                      <SelectItem value="Executive">Executive</SelectItem>
                      <SelectItem value="Senior Manager">
                        Senior Manager
                      </SelectItem>
                      <SelectItem value="Director">Director</SelectItem>
                    </SelectContent>
                  </Select>
                  {errors.gradeName && (
                    <p className="text-red-500 text-xs mt-1">
                      {errors.gradeName.message}
                    </p>
                  )}
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">
                    Group Type <span className="text-red-500">*</span>
                  </label>
                  <Select
                    value={watch("groupTypeName")}
                    onValueChange={(value) => setValue("groupTypeName", value)}
                  >
                    <SelectTrigger
                      className={errors.groupTypeName ? "border-red-500" : ""}
                    >
                      <SelectValue placeholder="--Select--" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="VKS">VKS</SelectItem>
                      <SelectItem value="Admin">Admin</SelectItem>
                      <SelectItem value="HR">HR</SelectItem>
                      <SelectItem value="Finance">Finance</SelectItem>
                    </SelectContent>
                  </Select>
                  {errors.groupTypeName && (
                    <p className="text-red-500 text-xs mt-1">
                      {errors.groupTypeName.message}
                    </p>
                  )}
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">
                    Department Type <span className="text-red-500">*</span>
                  </label>
                  <Select
                    value={watch("departmentName")}
                    onValueChange={(value) => setValue("departmentName", value)}
                  >
                    <SelectTrigger
                      className={errors.departmentName ? "border-red-500" : ""}
                    >
                      <SelectValue placeholder="--Select--" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="Sales and Marketing">
                        Sales and Marketing
                      </SelectItem>
                      <SelectItem value="Human Resources">
                        Human Resources
                      </SelectItem>
                      <SelectItem value="Finance">Finance</SelectItem>
                      <SelectItem value="Operations">Operations</SelectItem>
                      <SelectItem value="IT">IT</SelectItem>
                    </SelectContent>
                  </Select>
                  {errors.departmentName && (
                    <p className="text-red-500 text-xs mt-1">
                      {errors.departmentName.message}
                    </p>
                  )}
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">
                    Designation Type <span className="text-red-500">*</span>
                  </label>
                  <Select
                    value={watch("designationName")}
                    onValueChange={(value) =>
                      setValue("designationName", value)
                    }
                  >
                    <SelectTrigger
                      className={errors.designationName ? "border-red-500" : ""}
                    >
                      <SelectValue placeholder="--Select--" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="Assistant Business Development Manager">
                        Assistant Business Development Manager
                      </SelectItem>
                      <SelectItem value="Business Development Manager">
                        Business Development Manager
                      </SelectItem>
                      <SelectItem value="Senior Business Development Manager">
                        Senior Business Development Manager
                      </SelectItem>
                      <SelectItem value="Team Lead">Team Lead</SelectItem>
                      <SelectItem value="Senior Manager">
                        Senior Manager
                      </SelectItem>
                    </SelectContent>
                  </Select>
                  {errors.designationName && (
                    <p className="text-red-500 text-xs mt-1">
                      {errors.designationName.message}
                    </p>
                  )}
                </div>
              </div>

              {/* Right Column */}
              <div className="space-y-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">
                    Leave Type <span className="text-red-500">*</span>
                  </label>
                  <Select
                    value={watch("leaveType")}
                    onValueChange={(value) => setValue("leaveType", value)}
                  >
                    <SelectTrigger
                      className={errors.leaveType ? "border-red-500" : ""}
                    >
                      <SelectValue placeholder="--Select--" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="Comp Off">Comp Off</SelectItem>
                      <SelectItem value="Optional Leave">
                        Optional Leave
                      </SelectItem>
                      <SelectItem value="Casual Leave">Casual Leave</SelectItem>
                      <SelectItem value="Sick Leave">Sick Leave</SelectItem>
                      <SelectItem value="Emergency Leave">
                        Emergency Leave
                      </SelectItem>
                      <SelectItem value="Privilege Leave">
                        Privilege Leave
                      </SelectItem>
                    </SelectContent>
                  </Select>
                  {errors.leaveType && (
                    <p className="text-red-500 text-xs mt-1">
                      {errors.leaveType.message}
                    </p>
                  )}
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">
                    Order Of Approval <span className="text-red-500">*</span>
                  </label>
                  <Select
                    value={watch("orderOfApproval")}
                    onValueChange={(value) =>
                      setValue("orderOfApproval", value)
                    }
                  >
                    <SelectTrigger
                      className={errors.orderOfApproval ? "border-red-500" : ""}
                    >
                      <SelectValue placeholder="--Select--" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="1">1</SelectItem>
                      <SelectItem value="2">2</SelectItem>
                      <SelectItem value="3">3</SelectItem>
                      <SelectItem value="4">4</SelectItem>
                      <SelectItem value="5">5</SelectItem>
                    </SelectContent>
                  </Select>
                  {errors.orderOfApproval && (
                    <p className="text-red-500 text-xs mt-1">
                      {errors.orderOfApproval.message}
                    </p>
                  )}
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">
                    Approval Person <span className="text-red-500">*</span>
                  </label>
                  <Select
                    value={watch("approvalPerson")}
                    onValueChange={(value) => setValue("approvalPerson", value)}
                  >
                    <SelectTrigger
                      className={errors.approvalPerson ? "border-red-500" : ""}
                    >
                      <SelectValue placeholder="--Select--" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="Benoy Yogesh Shetty">
                        Benoy Yogesh Shetty
                      </SelectItem>
                      <SelectItem value="R Siddesh Kumar">
                        R Siddesh Kumar
                      </SelectItem>
                      <SelectItem value="John Doe">John Doe</SelectItem>
                      <SelectItem value="Jane Smith">Jane Smith</SelectItem>
                    </SelectContent>
                  </Select>
                  {errors.approvalPerson && (
                    <p className="text-red-500 text-xs mt-1">
                      {errors.approvalPerson.message}
                    </p>
                  )}
                </div>

                <div className="flex items-center space-x-2">
                  <Checkbox
                    id="finalFlag"
                    checked={watch("finalFlag")}
                    onCheckedChange={(checked) =>
                      setValue("finalFlag", checked as boolean)
                    }
                  />
                  <label
                    htmlFor="finalFlag"
                    className="text-sm font-medium text-gray-700"
                  >
                    Final Flag
                  </label>
                </div>
              </div>
            </div>

            {/* Action Buttons */}
            <div className="flex gap-4 pt-4">
              <Button
                type="submit"
                className="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2"
              >
                + ADD TO CART
              </Button>
              <Button
                type="button"
                variant="destructive"
                onClick={handleClear}
                className="px-6 py-2"
              >
                X CANCEL
              </Button>
            </div>
          </form>
        </div>

        {/* Grid View Section */}
        <div className="bg-white rounded-lg shadow-sm p-6">
          <h2 className="text-lg font-semibold text-gray-900 mb-4">
            GRID VIEW
          </h2>

          {/* General Search */}
          <div className="mb-4">
            <div className="relative">
              <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 h-4 w-4" />
              <input
                type="text"
                placeholder="search here..."
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                className="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
            </div>
          </div>

          {/* Individual Column Search Fields */}
          <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-4 mb-6">
            <input
              type="text"
              placeholder="search grade name..."
              className="px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <input
              type="text"
              placeholder="search department ni..."
              className="px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <input
              type="text"
              placeholder="search desgination na..."
              className="px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <input
              type="text"
              placeholder="search group type na..."
              className="px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <input
              type="text"
              placeholder="search leave type..."
              className="px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <input
              type="text"
              placeholder="search email id..."
              className="px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <input
              type="text"
              placeholder="search Sanctioned us..."
              className="px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <input
              type="text"
              placeholder="search Sanctioned on..."
              className="px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          {/* Data Table */}
          <div className="overflow-x-auto">
            <DataTable
              data={filteredData}
              columns={columns}
              totalItems={filteredData.length}
            />
          </div>
        </div>
      </div>
    </div>
  );
}
