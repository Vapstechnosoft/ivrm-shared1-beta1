'use client';

import { Heading } from '@/components/layout/heading';
import { DataTable } from '@/components/ui/data-table/data-table';
import { Button } from '@/components/ui/button';
import { CollapsibleSection } from '@/components/ui/form/collapsible-section';
import { FormError } from '@/components/ui/extension/field';
import { InputText } from '@/components/ui/extension/input-text';
import { Badge } from '@/components/ui/badge';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { DataTableColumnHeader } from '@/components/ui/data-table-column-header';
import { Checkbox } from '@/components/ui/checkbox';
import type { ColumnDef } from '@tanstack/react-table';
import { Plus, Edit, Trash2, X, Save, RefreshCw } from 'lucide-react';
import React, { useState, useEffect, useRef } from 'react';
import { type SubmitHandler, useForm } from 'react-hook-form';
import { toast } from 'sonner';
import { createLocalCrud, type BaseEntity } from '@/lib/localdb';

interface MRF extends BaseEntity {
  department: string;
  position: string;
  priority: string;
  positionType: string;
  qualification: string;
  noOfPosition: number;
  age: string;
  gender: string;
  expFrom: number;
  expTo: number;
  payScaleFrom?: string;
  payScaleTo?: string;
  skill: string;
  jobDescription: string;
  locationType: 'HO' | 'Client' | 'Location';
  country: string;
  state: string;
  remark?: string;
  reason: string;
  tests: { written: boolean; online: boolean; technical: boolean };
  status: 'Pending' | 'Approved' | 'Rejected';
}

type MRFForm = {
  department: string;
  position: string;
  priority: string;
  positionType: string;
  qualification: string;
  noOfPosition: string;
  age: string;
  gender: string;
  expFrom: string;
  expTo: string;
  payScaleFrom?: string;
  payScaleTo?: string;
  skill: string;
  jobDescription: string;
  locationType: 'HO' | 'Client' | 'Location';
  country: string;
  state: string;
  remark?: string;
  reason: string;
};

export default function MRFPage() {
  const [mrfList, setMrfList] = useState<MRF[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [isFormOpen, setIsFormOpen] = useState(false);
  const [editingMRF, setEditingMRF] = useState<MRF | null>(null);
  const [tests, setTests] = useState({ written: false, online: false, technical: false });
  const formRef = useRef<HTMLDivElement>(null);

  const mrfDB = createLocalCrud<MRF>('recruitment:mrf');

  const { register, handleSubmit, reset, setValue, watch, formState: { errors, isSubmitting } } = useForm<MRFForm>({ mode: 'onChange' });

  useEffect(() => { loadData(); }, []);

  const loadData = () => {
    try { setMrfList(mrfDB.list()); } catch { toast.error('Failed to load MRFs'); } finally { setIsLoading(false); }
  };

  const handleAddClick = () => { setIsFormOpen(true); setTimeout(() => formRef.current?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100); };
  const handleFormClose = () => { setIsFormOpen(false); setEditingMRF(null); reset(); setTests({ written: false, online: false, technical: false }); };

  const onSubmit: SubmitHandler<MRFForm> = async (data) => {
    try {
      const mrf: Omit<MRF, 'id' | 'createdAt'> = {
        department: data.department,
        position: data.position,
        priority: data.priority,
        positionType: data.positionType,
        qualification: data.qualification,
        noOfPosition: Number(data.noOfPosition || 0),
        age: data.age,
        gender: data.gender,
        expFrom: Number(data.expFrom || 0),
        expTo: Number(data.expTo || 0),
        payScaleFrom: data.payScaleFrom,
        payScaleTo: data.payScaleTo,
        skill: data.skill,
        jobDescription: data.jobDescription,
        locationType: data.locationType,
        country: data.country,
        state: data.state,
        remark: data.remark,
        reason: data.reason,
        tests,
        status: 'Pending'
      };

      if (editingMRF) { mrfDB.update(editingMRF.id, mrf); toast.success('MRF updated'); } else { mrfDB.create(mrf); toast.success('MRF saved'); }
      handleFormClose();
      loadData();
    } catch (e: any) { toast.error(e.message || 'Operation failed'); }
  };

  const handleEdit = (m: MRF) => {
    setEditingMRF(m);
    reset({
      department: m.department,
      position: m.position,
      priority: m.priority,
      positionType: m.positionType,
      qualification: m.qualification,
      noOfPosition: String(m.noOfPosition),
      age: m.age,
      gender: m.gender,
      expFrom: String(m.expFrom),
      expTo: String(m.expTo),
      payScaleFrom: m.payScaleFrom,
      payScaleTo: m.payScaleTo,
      skill: m.skill,
      jobDescription: m.jobDescription,
      locationType: m.locationType,
      country: m.country,
      state: m.state,
      remark: m.remark,
      reason: m.reason,
    });
    setTests(m.tests || { written: false, online: false, technical: false });
    setIsFormOpen(true);
    setTimeout(() => formRef.current?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
  };

  const handleDelete = (m: MRF) => { mrfDB.remove(m.id); toast.success('MRF deleted'); loadData(); };

  return (
    <div className='min-h-screen'>
      <div className='container p-1 space-y-4'>
        <div className='flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'>
          <div className='space-y-1'>
            <Heading title='HRMS - MRF Requisition' description='Create and manage manpower requisitions' />
          </div>
          <Button type='button' onClick={handleAddClick} size='lg' className='transition-all duration-200 hover:scale-105 shadow-md hover:shadow-lg w-fit'>
            <Plus className='h-4 w-4' />
            New MRF
          </Button>
        </div>

        <CollapsibleSection title='MRF Requisition Details' description='Search and manage MRF records' defaultOpen={true} variant='default' size='lg' className='shadow-lg transition-shadow duration-300 hover:shadow-xl' headerClassName=''>
          <MRFTable data={mrfList} isLoading={isLoading} onEdit={handleEdit} onDelete={handleDelete} />
        </CollapsibleSection>

        {isFormOpen && (
          <div ref={formRef}>
            <CollapsibleSection title={editingMRF ? 'Edit MRF' : 'New MRF'} description='Fill requisition details' defaultOpen={true} variant='default' size='lg' className='shadow-lg transition-shadow duration-300 hover:shadow-xl'>
              <form onSubmit={handleSubmit(onSubmit)} className='space-y-6'>
                <div className='grid grid-cols-1 md:grid-cols-2 gap-6'>
                  <div className='space-y-3'>
                    <label className='text-sm font-medium'>Department <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(v)=>setValue('department', v)}>
                      <SelectTrigger><SelectValue placeholder='--Select--' /></SelectTrigger>
                      <SelectContent>
                        <SelectItem value='IT'>IT</SelectItem>
                        <SelectItem value='HR'>HR</SelectItem>
                        <SelectItem value='Finance'>Finance</SelectItem>
                        <SelectItem value='Operations'>Operations</SelectItem>
                      </SelectContent>
                    </Select>

                    <label className='text-sm font-medium'>Position <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(v)=>setValue('position', v)}>
                      <SelectTrigger><SelectValue placeholder='--Select--' /></SelectTrigger>
                      <SelectContent>
                        <SelectItem value='Software Engineer'>Software Engineer</SelectItem>
                        <SelectItem value='Project Manager'>Project Manager</SelectItem>
                        <SelectItem value='HR Executive'>HR Executive</SelectItem>
                      </SelectContent>
                    </Select>

                    <label className='text-sm font-medium'>Priority <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(v)=>setValue('priority', v)}>
                      <SelectTrigger><SelectValue placeholder='--Select--' /></SelectTrigger>
                      <SelectContent>
                        <SelectItem value='Critical'>Critical</SelectItem>
                        <SelectItem value='High'>High</SelectItem>
                        <SelectItem value='Medium'>Medium</SelectItem>
                        <SelectItem value='Low'>Low</SelectItem>
                      </SelectContent>
                    </Select>

                    <label className='text-sm font-medium'>Position Type <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(v)=>setValue('positionType', v)}>
                      <SelectTrigger><SelectValue placeholder='--Select--' /></SelectTrigger>
                      <SelectContent>
                        <SelectItem value='Full Time'>Full Time</SelectItem>
                        <SelectItem value='Part Time'>Part Time</SelectItem>
                        <SelectItem value='Contract'>Contract</SelectItem>
                      </SelectContent>
                    </Select>

                    <label className='text-sm font-medium'>Qualification <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(v)=>setValue('qualification', v)}>
                      <SelectTrigger><SelectValue placeholder='--Select--' /></SelectTrigger>
                      <SelectContent>
                        <SelectItem value='B.Tech'>B.Tech</SelectItem>
                        <SelectItem value='M.Tech'>M.Tech</SelectItem>
                        <SelectItem value='MBA'>MBA</SelectItem>
                      </SelectContent>
                    </Select>

                    <label className='text-sm font-medium'>No of Position <span className='text-red-500'>*</span></label>
                    <InputText placeholder='1' {...register('noOfPosition', { required: 'Required' })} error={errors.noOfPosition?.message} />

                    <label className='text-sm font-medium'>Age <span className='text-red-500'>*</span></label>
                    <InputText placeholder='e.g. 22-30' {...register('age', { required: 'Required' })} error={errors.age?.message} />

                    <label className='text-sm font-medium'>Gender <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(v)=>setValue('gender', v)}>
                      <SelectTrigger><SelectValue placeholder='--Select--' /></SelectTrigger>
                      <SelectContent>
                        <SelectItem value='Male'>Male</SelectItem>
                        <SelectItem value='Female'>Female</SelectItem>
                        <SelectItem value='Any'>Any</SelectItem>
                      </SelectContent>
                    </Select>

                    <label className='text-sm font-medium'>Experience <span className='text-red-500'>*</span></label>
                    <div className='grid grid-cols-3 gap-2 items-center'>
                      <InputText placeholder='From' {...register('expFrom', { required: 'Required' })} error={errors.expFrom?.message} />
                      <span className='text-center'>To</span>
                      <InputText placeholder='To' {...register('expTo', { required: 'Required' })} error={errors.expTo?.message} />
                    </div>

                    <label className='text-sm font-medium'>Pay Scale</label>
                    <div className='grid grid-cols-3 gap-2 items-center'>
                      <InputText placeholder='From' {...register('payScaleFrom')} />
                      <span className='text-center'>To</span>
                      <InputText placeholder='To' {...register('payScaleTo')} />
                    </div>
                  </div>

                  <div className='space-y-3'>
                    <label className='text-sm font-medium'>Skill <span className='text-red-500'>*</span></label>
                    <InputText placeholder='Primary skills' {...register('skill', { required: 'Required' })} error={errors.skill?.message} />

                    <label className='text-sm font-medium'>Job Description <span className='text-red-500'>*</span></label>
                    <InputText placeholder='Enter description' {...register('jobDescription', { required: 'Required' })} error={errors.jobDescription?.message} />

                    <label className='text-sm font-medium'>Location <span className='text-red-500'>*</span></label>
                    <div className='flex items-center gap-6 pt-1'>
                      <label className='flex items-center gap-2 text-sm'><Checkbox checked={watch('locationType')==='HO'} onCheckedChange={(v)=>setValue('locationType','HO')} /> HO</label>
                      <label className='flex items-center gap-2 text-sm'><Checkbox checked={watch('locationType')==='Client'} onCheckedChange={(v)=>setValue('locationType','Client')} /> Client</label>
                      <label className='flex items-center gap-2 text-sm'><Checkbox checked={watch('locationType')==='Location'} onCheckedChange={(v)=>setValue('locationType','Location')} /> Location</label>
                    </div>

                    <label className='text-sm font-medium'>Country <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(v)=>setValue('country', v)}>
                      <SelectTrigger><SelectValue placeholder='--Select--' /></SelectTrigger>
                      <SelectContent>
                        <SelectItem value='India'>India</SelectItem>
                        <SelectItem value='USA'>USA</SelectItem>
                        <SelectItem value='UK'>UK</SelectItem>
                      </SelectContent>
                    </Select>

                    <label className='text-sm font-medium'>State <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(v)=>setValue('state', v)}>
                      <SelectTrigger><SelectValue placeholder='--Select--' /></SelectTrigger>
                      <SelectContent>
                        <SelectItem value='Karnataka'>Karnataka</SelectItem>
                        <SelectItem value='Maharashtra'>Maharashtra</SelectItem>
                        <SelectItem value='Tamil Nadu'>Tamil Nadu</SelectItem>
                      </SelectContent>
                    </Select>

                    <label className='text-sm font-medium'>Remark</label>
                    <InputText placeholder='Enter remark' {...register('remark')} />

                    <label className='text-sm font-medium'>Reason <span className='text-red-500'>*</span></label>
                    <InputText placeholder='Enter reason' {...register('reason', { required: 'Required' })} error={errors.reason?.message} />

                    <div className='flex gap-6 pt-2'>
                      <label className='flex items-center gap-2 text-sm'><Checkbox checked={tests.written} onCheckedChange={(v)=>setTests(s=>({...s, written: Boolean(v)}))} /> Written Test</label>
                      <label className='flex items-center gap-2 text-sm'><Checkbox checked={tests.online} onCheckedChange={(v)=>setTests(s=>({...s, online: Boolean(v)}))} /> Online Test</label>
                      <label className='flex items-center gap-2 text-sm'><Checkbox checked={tests.technical} onCheckedChange={(v)=>setTests(s=>({...s, technical: Boolean(v)}))} /> Technical Interview</label>
                    </div>
                  </div>
                </div>

                <div className='flex justify-center gap-4 pt-6 border-t'>
                  <Button type='button' variant='outline' onClick={handleFormClose}>
                    <X className='mr-2 h-4 w-4' />
                    Cancel
                  </Button>
                  <Button type='submit' disabled={isSubmitting}>
                    {isSubmitting ? (
                      <div className='flex items-center'>
                        <RefreshCw className='mr-2 h-4 w-4 animate-spin' />
                        Saving...
                      </div>
                    ) : (
                      <div className='flex items-center'>
                        <Save className='mr-2 h-4 w-4' />
                        Save
                      </div>
                    )}
                  </Button>
                </div>
              </form>
            </CollapsibleSection>
          </div>
        )}
      </div>
    </div>
  );
}

interface MRFTableProps { data: MRF[]; isLoading: boolean; onEdit: (m: MRF) => void; onDelete: (m: MRF) => void; }

function MRFTable({ data, isLoading, onEdit, onDelete }: MRFTableProps) {
  const columns: ColumnDef<MRF>[] = [
    { id: 'sl', header: ({ column }) => <DataTableColumnHeader column={column} title='SL.NO.' />, cell: ({ row }) => <div className='font-medium'>{row.index + 1}</div>, enableSorting: false },
    { accessorKey: 'department', header: ({ column }) => <DataTableColumnHeader column={column} title='Department' /> },
    { accessorKey: 'position', header: ({ column }) => <DataTableColumnHeader column={column} title='Position' /> },
    { accessorKey: 'priority', header: ({ column }) => <DataTableColumnHeader column={column} title='Priority' /> },
    { accessorKey: 'positionType', header: ({ column }) => <DataTableColumnHeader column={column} title='Position Type' /> },
    { accessorKey: 'noOfPosition', header: ({ column }) => <DataTableColumnHeader column={column} title='No of Position' /> },
    { accessorKey: 'gender', header: ({ column }) => <DataTableColumnHeader column={column} title='Gender' /> },
    { accessorKey: 'locationType', header: ({ column }) => <DataTableColumnHeader column={column} title='Location' /> },
    { accessorKey: 'status', header: ({ column }) => <DataTableColumnHeader column={column} title='Status' />, cell: ({ row }) => {
      const status = row.getValue('status') as string;
      const map: Record<string,string> = { Pending: 'bg-yellow-100 text-yellow-800', Approved: 'bg-green-100 text-green-800', Rejected: 'bg-red-100 text-red-800' };
      return <Badge className={map[status] || 'bg-gray-100 text-gray-800'}>{status}</Badge>;
    } },
    { id: 'action', header: 'Action', cell: ({ row }) => {
      const m = row.original;
      return (
        <div className='flex items-center gap-2'>
          <Button variant='outline' size='sm' onClick={() => onEdit(m)}><Edit className='h-4 w-4' /></Button>
          <Button variant='outline' size='sm' className='text-red-600' onClick={() => onDelete(m)}><Trash2 className='h-4 w-4' /></Button>
        </div>
      );
    } }
  ];

  return <DataTable isLoading={isLoading} columns={columns} data={data} totalItems={data.length} showViewOptions />;
}
