'use client';

import { Heading } from '@/components/layout/heading';
import { DataTable } from '@/components/ui/data-table/data-table';
import { Button } from '@/components/ui/button';
import { CollapsibleSection } from '@/components/ui/form/collapsible-section';
import { FormError } from '@/components/ui/extension/field';
import { InputText } from '@/components/ui/extension/input-text';
import { Badge } from '@/components/ui/badge';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { DataTableColumnHeader } from '@/components/ui/data-table-column-header';
import { DropdownMenu, DropdownMenuContent, DropdownMenuLabel, DropdownMenuTrigger } from '@/components/ui/dropdown-menu';
import { Checkbox } from '@/components/ui/checkbox';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import type { ColumnDef } from '@tanstack/react-table';
import { Plus, MoreHorizontal, Edit, Trash2, X, Save, RefreshCw, Upload, FileText, User, GraduationCap, Briefcase, Users, MessageSquare, FileImage } from 'lucide-react';
import React, { useState, useEffect, useRef } from 'react';
import { type SubmitHandler, useForm } from 'react-hook-form';
import { toast } from 'sonner';
import { createLocalCrud, type BaseEntity } from '@/lib/localdb';

interface Candidate extends BaseEntity {
  // Personal Details
  firstName: string;
  middleName?: string;
  lastName: string;
  skill: string;
  mobileNo: string;
  emailId: string;
  qualification: string;
  jobTitle: string;
  currentCompany?: string;
  totalExp: string;
  lastCTC: string;
  expectedCTC: string;
  applicationDate: string;
  interviewDate: string;
  dateOfBirth: string;
  
  // Additional Details
  nationality: string;
  religion: string;
  caste: string;
  gender: string;
  maritalStatus: string;
  bloodGroup: string;
  positionType: string;
  position: string;
  aadharNo?: string;
  panCardNo?: string;
  refHR?: string;
  source?: string;
  remark?: string;
  consultency?: string;
  resumeCV?: string;
  
  // Address
  localAddressLine1: string;
  localAddressLine2?: string;
  localPlace: string;
  localPincode: string;
  permanentAddressLine1: string;
  permanentAddressLine2?: string;
  permanentPlace: string;
  permanentPincode: string;
  sameAsLocalAddress: boolean;
  
  // Qualifications
  qualifications: QualificationDetail[];
  
  // Experience
  experiences: ExperienceDetail[];
  
  // Family
  familyMembers: FamilyDetail[];
  
  // Languages
  languages: LanguageDetail[];
  
  // Documents
  documents: DocumentDetail[];
  
  status: string;
}

interface QualificationDetail {
  serialNo: number;
  course: string;
  boardName: string;
  yearOfPassing: string;
}

interface ExperienceDetail {
  serialNo: number;
  companyName: string;
  designation: string;
  dateOfJoin: string;
  dateOfLeave: string;
  annualSalary: string;
}

interface FamilyDetail {
  serialNo: number;
  familyMemberName: string;
  relationship: string;
  occupation: string;
  workPlace: string;
  age: string;
}

interface LanguageDetail {
  serialNo: number;
  toRead: string;
  toWrite: string;
  toSpeak: string;
}

interface DocumentDetail {
  serialNo: number;
  upload: string;
  view: string;
  remark: string;
}

type CandidateForm = {
  firstName: string;
  middleName?: string;
  lastName: string;
  skill: string;
  mobileNo: string;
  emailId: string;
  qualification: string;
  jobTitle: string;
  currentCompany?: string;
  totalExp: string;
  lastCTC: string;
  expectedCTC: string;
  applicationDate: string;
  interviewDate: string;
  dateOfBirth: string;
  nationality: string;
  religion: string;
  caste: string;
  gender: string;
  maritalStatus: string;
  bloodGroup: string;
  positionType: string;
  position: string;
  aadharNo?: string;
  panCardNo?: string;
  refHR?: string;
  source?: string;
  remark?: string;
  consultency?: string;
  resumeCV?: string;
  localAddressLine1: string;
  localAddressLine2?: string;
  localPlace: string;
  localPincode: string;
  permanentAddressLine1: string;
  permanentAddressLine2?: string;
  permanentPlace: string;
  permanentPincode: string;
  sameAsLocalAddress: boolean;
};

export default function AddCandidatePage() {
  const [candidates, setCandidates] = useState<Candidate[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [isFormOpen, setIsFormOpen] = useState(false);
  const [editingCandidate, setEditingCandidate] = useState<Candidate | null>(null);
  const [qualifications, setQualifications] = useState<QualificationDetail[]>([]);
  const [experiences, setExperiences] = useState<ExperienceDetail[]>([]);
  const [familyMembers, setFamilyMembers] = useState<FamilyDetail[]>([]);
  const [languages, setLanguages] = useState<LanguageDetail[]>([]);
  const [documents, setDocuments] = useState<DocumentDetail[]>([]);
  const formRef = useRef<HTMLDivElement>(null);

  const candidateDB = createLocalCrud<Candidate>('recruitment:candidate');

  const {
    register,
    handleSubmit,
    reset,
    setValue,
    watch,
    formState: { errors, isSubmitting }
  } = useForm<CandidateForm>({
    mode: 'onChange',
    defaultValues: {
      applicationDate: new Date().toISOString().split('T')[0],
      interviewDate: new Date().toISOString().split('T')[0],
      dateOfBirth: new Date().toISOString().split('T')[0],
      sameAsLocalAddress: false
    }
  });

  const sameAsLocalAddress = watch('sameAsLocalAddress');

  // Load data on component mount
  useEffect(() => {
    loadCandidates();
  }, []);

  const loadCandidates = () => {
    try {
      setCandidates(candidateDB.list());
    } catch (error) {
      toast.error('Failed to load candidates');
    } finally {
      setIsLoading(false);
    }
  };

  const handleAddClick = () => {
    setIsFormOpen(true);
    setTimeout(() => {
      formRef.current?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  };

  const handleFormClose = () => {
    setIsFormOpen(false);
    setEditingCandidate(null);
    reset();
    setQualifications([]);
    setExperiences([]);
    setFamilyMembers([]);
    setLanguages([]);
    setDocuments([]);
  };

  const onSubmit: SubmitHandler<CandidateForm> = async (data: CandidateForm) => {
    try {
      const candidateData: Omit<Candidate, 'id' | 'createdAt'> = {
        ...data,
        qualifications,
        experiences,
        familyMembers,
        languages,
        documents,
        status: editingCandidate?.status || 'New'
      };

      if (editingCandidate) {
        candidateDB.update(editingCandidate.id, candidateData);
        toast.success('Candidate updated successfully');
      } else {
      candidateDB.create(candidateData);
      toast.success('Candidate added successfully');
      }
      handleFormClose();
      loadCandidates();
    } catch (error: any) {
      toast.error(error.message || 'Operation failed');
    }
  };

  const handleClear = () => {
    handleFormClose();
    toast.info('Form cleared');
  };

  const handleEdit = (candidate: Candidate) => {
    setEditingCandidate(candidate);
    // Populate form with candidate data
    reset({
      firstName: candidate.firstName,
      middleName: candidate.middleName,
      lastName: candidate.lastName,
      skill: candidate.skill,
      mobileNo: candidate.mobileNo,
      emailId: candidate.emailId,
      qualification: candidate.qualification,
      jobTitle: candidate.jobTitle,
      currentCompany: candidate.currentCompany,
      totalExp: candidate.totalExp,
      lastCTC: candidate.lastCTC,
      expectedCTC: candidate.expectedCTC,
      applicationDate: candidate.applicationDate,
      interviewDate: candidate.interviewDate,
      dateOfBirth: candidate.dateOfBirth,
      nationality: candidate.nationality,
      religion: candidate.religion,
      caste: candidate.caste,
      gender: candidate.gender,
      maritalStatus: candidate.maritalStatus,
      bloodGroup: candidate.bloodGroup,
      positionType: candidate.positionType,
      position: candidate.position,
      aadharNo: candidate.aadharNo,
      panCardNo: candidate.panCardNo,
      refHR: candidate.refHR,
      source: candidate.source,
      remark: candidate.remark,
      consultency: candidate.consultency,
      resumeCV: candidate.resumeCV,
      localAddressLine1: candidate.localAddressLine1,
      localAddressLine2: candidate.localAddressLine2,
      localPlace: candidate.localPlace,
      localPincode: candidate.localPincode,
      permanentAddressLine1: candidate.permanentAddressLine1,
      permanentAddressLine2: candidate.permanentAddressLine2,
      permanentPlace: candidate.permanentPlace,
      permanentPincode: candidate.permanentPincode,
      sameAsLocalAddress: candidate.sameAsLocalAddress
    });
    setQualifications(candidate.qualifications || []);
    setExperiences(candidate.experiences || []);
    setFamilyMembers(candidate.familyMembers || []);
    setLanguages(candidate.languages || []);
    setDocuments(candidate.documents || []);
    setIsFormOpen(true);
    setTimeout(() => {
      formRef.current?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  };

  const handleDelete = async (candidate: Candidate) => {
    try {
      candidateDB.remove(candidate.id);
      toast.success('Candidate deleted successfully');
      loadCandidates();
    } catch (error) {
      toast.error('Failed to delete candidate');
    }
  };

  // Copy local address to permanent address
  useEffect(() => {
    if (sameAsLocalAddress) {
      const localAddressLine1 = watch('localAddressLine1');
      const localAddressLine2 = watch('localAddressLine2');
      const localPlace = watch('localPlace');
      const localPincode = watch('localPincode');
      
      setValue('permanentAddressLine1', localAddressLine1);
      setValue('permanentAddressLine2', localAddressLine2);
      setValue('permanentPlace', localPlace);
      setValue('permanentPincode', localPincode);
    }
  }, [sameAsLocalAddress, watch]);

  const addQualification = () => {
    setQualifications([...qualifications, {
      serialNo: qualifications.length + 1,
      course: '',
      boardName: '',
      yearOfPassing: ''
    }]);
  };

  const addExperience = () => {
    setExperiences([...experiences, {
      serialNo: experiences.length + 1,
      companyName: '',
      designation: '',
      dateOfJoin: '',
      dateOfLeave: '',
      annualSalary: ''
    }]);
  };

  const addFamilyMember = () => {
    setFamilyMembers([...familyMembers, {
      serialNo: familyMembers.length + 1,
      familyMemberName: '',
      relationship: '',
      occupation: '',
      workPlace: '',
      age: ''
    }]);
  };

  const addLanguage = () => {
    setLanguages([...languages, {
      serialNo: languages.length + 1,
      toRead: '',
      toWrite: '',
      toSpeak: ''
    }]);
  };

  const addDocument = () => {
    setDocuments([...documents, {
      serialNo: documents.length + 1,
      upload: '',
      view: '',
      remark: ''
    }]);
  };

  return (
    <div className='min-h-screen'>
      <div className='container p-1 space-y-4'>
        {/* Header */}
        <div className='flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'>
          <div className='space-y-1'>
            <Heading
              title='Candidate Management'
              description='Manage and track candidates in the recruitment system'
            />
          </div>
          <Button
            type='button'
            onClick={handleAddClick}
            size='lg'
            className='transition-all duration-200 hover:scale-105 shadow-md hover:shadow-lg w-fit'>
            <Plus className='h-4 w-4' />
            Add Candidate
          </Button>
        </div>

        {/* Data Table Section - Collapsible but default open */}
        <CollapsibleSection
          title='Candidates Data'
          description='View, search, and manage all candidates in the system'
          defaultOpen={true}
          variant='default'
          size='lg'
          className='shadow-lg transition-shadow duration-300 hover:shadow-xl'
          headerClassName=''>
          <CandidateTable candidates={candidates} isLoading={isLoading} onEdit={handleEdit} onDelete={handleDelete} />
        </CollapsibleSection>

        {/* Add Form Section - Conditionally Rendered */}
        {isFormOpen && (
          <div ref={formRef}>
        {/* Candidate Form */}
        <CollapsibleSection
          title={editingCandidate ? 'Edit Candidate Details' : 'Add Candidate Details'}
          description={editingCandidate ? 'Update candidate information across different sections' : 'Fill in candidate information across different sections'}
          defaultOpen={true}
          variant='default'
          size='lg'
          className='shadow-lg transition-shadow duration-300 hover:shadow-xl'>
          
          <form onSubmit={handleSubmit(onSubmit)} className='space-y-6'>
            <Tabs defaultValue="candidate" className="w-full">
              <TabsList className="grid w-full grid-cols-6">
                <TabsTrigger value="candidate" className="flex items-center gap-2">
                  <User className="h-4 w-4" />
                  Candidate
                </TabsTrigger>
                <TabsTrigger value="qualification" className="flex items-center gap-2">
                  <GraduationCap className="h-4 w-4" />
                  Qualification
                </TabsTrigger>
                <TabsTrigger value="experience" className="flex items-center gap-2">
                  <Briefcase className="h-4 w-4" />
                  Experience
                </TabsTrigger>
                <TabsTrigger value="family" className="flex items-center gap-2">
                  <Users className="h-4 w-4" />
                  Family
                </TabsTrigger>
                <TabsTrigger value="language" className="flex items-center gap-2">
                  <MessageSquare className="h-4 w-4" />
                  Language
                </TabsTrigger>
                <TabsTrigger value="documents" className="flex items-center gap-2">
                  <FileImage className="h-4 w-4" />
                  Documents
                </TabsTrigger>
              </TabsList>

              {/* Candidate Tab */}
              <TabsContent value="candidate" className="space-y-4">
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  <InputText
                    label='First Name'
                    required
                    placeholder='Vinod'
                    {...register('firstName', { required: 'First Name is required' })}
                    error={errors.firstName?.message}
                  />
                  <InputText
                    label='Middle Name'
                    placeholder='Kumar'
                    {...register('middleName')}
                  />
                  <InputText
                    label='Last Name'
                    required
                    placeholder='Kumar'
                    {...register('lastName', { required: 'Last Name is required' })}
                    error={errors.lastName?.message}
                  />
                  
                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Nationality <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(value) => setValue('nationality', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="India" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="India">India</SelectItem>
                        <SelectItem value="Other">Other</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Religion <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(value) => setValue('religion', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="HINDU" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="HINDU">HINDU</SelectItem>
                        <SelectItem value="MUSLIM">MUSLIM</SelectItem>
                        <SelectItem value="CHRISTIAN">CHRISTIAN</SelectItem>
                        <SelectItem value="SIKH">SIKH</SelectItem>
                        <SelectItem value="OTHER">OTHER</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Caste <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(value) => setValue('caste', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="General" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="General">General</SelectItem>
                        <SelectItem value="OBC">OBC</SelectItem>
                        <SelectItem value="SC">SC</SelectItem>
                        <SelectItem value="ST">ST</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>

                  <InputText
                    label='Skill'
                    required
                    placeholder='Troubleshooting computers and basic networks'
                    {...register('skill', { required: 'Skill is required' })}
                    error={errors.skill?.message}
                  />

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Gender <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(value) => setValue('gender', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="MALE" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="MALE">MALE</SelectItem>
                        <SelectItem value="FEMALE">FEMALE</SelectItem>
                        <SelectItem value="OTHER">OTHER</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>

                  <InputText
                    label='Mobile No'
                    required
                    placeholder='9865151862'
                    {...register('mobileNo', { required: 'Mobile No is required' })}
                    error={errors.mobileNo?.message}
                  />

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Marital Status <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(value) => setValue('maritalStatus', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="MARRIED" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="MARRIED">MARRIED</SelectItem>
                        <SelectItem value="SINGLE">SINGLE</SelectItem>
                        <SelectItem value="DIVORCED">DIVORCED</SelectItem>
                        <SelectItem value="WIDOWED">WIDOWED</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>

                  <InputText
                    label='Email Id'
                    required
                    type='email'
                    placeholder='vinodkumar.c@hotmail.com'
                    {...register('emailId', { required: 'Email Id is required' })}
                    error={errors.emailId?.message}
                  />

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Blood Group <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(value) => setValue('bloodGroup', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="AB+" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="A+">A+</SelectItem>
                        <SelectItem value="A-">A-</SelectItem>
                        <SelectItem value="B+">B+</SelectItem>
                        <SelectItem value="B-">B-</SelectItem>
                        <SelectItem value="AB+">AB+</SelectItem>
                        <SelectItem value="AB-">AB-</SelectItem>
                        <SelectItem value="O+">O+</SelectItem>
                        <SelectItem value="O-">O-</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Qualification <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(value) => setValue('qualification', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="UG" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="UG">UG</SelectItem>
                        <SelectItem value="PG">PG</SelectItem>
                        <SelectItem value="PhD">PhD</SelectItem>
                        <SelectItem value="Diploma">Diploma</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Job Title <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(value) => setValue('jobTitle', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="Hardware and network engineer" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="Hardware and network engineer">Hardware and network engineer</SelectItem>
                        <SelectItem value="Software Engineer">Software Engineer</SelectItem>
                        <SelectItem value="IT Executive">IT Executive</SelectItem>
                        <SelectItem value="System Administrator">System Administrator</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>

                  <InputText
                    label='Job Name'
                    placeholder='Hardware & Networking Engineer, IT Hardware Engineer'
                    {...register('currentCompany')}
                  />

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Position Type <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(value) => setValue('positionType', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="Permanent" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="Permanent">Permanent</SelectItem>
                        <SelectItem value="Contract">Contract</SelectItem>
                        <SelectItem value="Part-time">Part-time</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>

                  <InputText
                    label='Current Company'
                    placeholder='ARC Documents India Pvt Ltd'
                    {...register('currentCompany')}
                  />

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Position <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(value) => setValue('position', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="Select Position" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="Junior">Junior</SelectItem>
                        <SelectItem value="Senior">Senior</SelectItem>
                        <SelectItem value="Lead">Lead</SelectItem>
                        <SelectItem value="Manager">Manager</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>

                  <InputText
                    label='Total Exp'
                    required
                    placeholder='8.9'
                    {...register('totalExp', { required: 'Total Experience is required' })}
                    error={errors.totalExp?.message}
                  />

                  <InputText
                    label='Aadhar No'
                    placeholder='626433943117'
                    {...register('aadharNo')}
                  />

                  <InputText
                    label='Last CTC(Monthly)'
                    required
                    placeholder='4.2'
                    {...register('lastCTC', { required: 'Last CTC is required' })}
                    error={errors.lastCTC?.message}
                  />

                  <InputText
                    label='PAN Card No'
                    placeholder='AKOPV0813E'
                    {...register('panCardNo')}
                  />

                  <InputText
                    label='Expected CTC(Monthly)'
                    required
                    placeholder='4.5'
                    {...register('expectedCTC', { required: 'Expected CTC is required' })}
                    error={errors.expectedCTC?.message}
                  />

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Ref. HR <span className='text-red-500'>*</span></label>
                    <Select onValueChange={(value) => setValue('refHR', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="Select HR" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="HR1">HR Manager 1</SelectItem>
                        <SelectItem value="HR2">HR Manager 2</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Application Date <span className='text-red-500'>*</span></label>
                    <input
                      type="date"
                      {...register('applicationDate', { required: 'Application Date is required' })}
                      className={`w-full px-3 py-2 border rounded-md ${errors.applicationDate ? 'border-red-500' : 'border-input'}`}
                    />
                    {errors.applicationDate && <FormError>{errors.applicationDate.message}</FormError>}
                  </div>

                  <InputText
                    label='Source'
                    {...register('source')}
                  />

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Interview Date <span className='text-red-500'>*</span></label>
                    <input
                      type="date"
                      {...register('interviewDate', { required: 'Interview Date is required' })}
                      className={`w-full px-3 py-2 border rounded-md ${errors.interviewDate ? 'border-red-500' : 'border-input'}`}
                    />
                    {errors.interviewDate && <FormError>{errors.interviewDate.message}</FormError>}
                  </div>

                  <InputText
                    label='Remark'
                    {...register('remark')}
                  />

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Date of Birth <span className='text-red-500'>*</span></label>
                    <input
                      type="date"
                      {...register('dateOfBirth', { required: 'Date of Birth is required' })}
                      className={`w-full px-3 py-2 border rounded-md ${errors.dateOfBirth ? 'border-red-500' : 'border-input'}`}
                    />
                    {errors.dateOfBirth && <FormError>{errors.dateOfBirth.message}</FormError>}
                  </div>

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Consultency</label>
                    <Select onValueChange={(value) => setValue('consultency', value)}>
                      <SelectTrigger>
                        <SelectValue placeholder="--Select--" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="Internal">Internal</SelectItem>
                        <SelectItem value="External">External</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>
                </div>

                {/* Address Section */}
                <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                  {/* Local Address */}
                  <Card>
                    <CardHeader>
                      <CardTitle className="text-sm">LOCAL ADDRESS</CardTitle>
                    </CardHeader>
                    <CardContent className="space-y-4">
                      <InputText
                        label='Address Line 1'
                        required
                        placeholder='No.11/1, Near Nanjappa Complex, RMV 2nd Stage, Geddalahalli, Sanjaynagar'
                        {...register('localAddressLine1', { required: 'Address Line 1 is required' })}
                        error={errors.localAddressLine1?.message}
                      />
                      <InputText
                        label='Address Line 2'
                        {...register('localAddressLine2')}
                      />
                      <InputText
                        label='Place'
                        required
                        placeholder='bang'
                        {...register('localPlace', { required: 'Place is required' })}
                        error={errors.localPlace?.message}
                      />
                      <InputText
                        label='Pincode'
                        required
                        placeholder='0'
                        {...register('localPincode', { required: 'Pincode is required' })}
                        error={errors.localPincode?.message}
                      />
                    </CardContent>
                  </Card>

                  {/* Permanent Address */}
                  <Card>
                    <CardHeader>
                      <CardTitle className="text-sm flex items-center gap-2">
                        PERMANENT ADDRESS
                        <div className='flex items-center gap-2'>
                          <Checkbox
                            checked={sameAsLocalAddress}
                            onCheckedChange={(checked) => setValue('sameAsLocalAddress', !!checked)}
                          />
                          <span className="text-xs">Same as Local Address ?</span>
                        </div>
                      </CardTitle>
                    </CardHeader>
                    <CardContent className="space-y-4">
                      <InputText
                        label='Address Line 1'
                        required
                        placeholder='No.11/1, Near Nanjappa Complex, RMV 2nd Stage, Geddalahalli, Sanjaynagar'
                        {...register('permanentAddressLine1', { required: 'Address Line 1 is required' })}
                        error={errors.permanentAddressLine1?.message}
                        disabled={sameAsLocalAddress}
                      />
                      <InputText
                        label='Address Line 2'
                        {...register('permanentAddressLine2')}
                        disabled={sameAsLocalAddress}
                      />
                      <InputText
                        label='Place'
                        required
                        placeholder='bang'
                        {...register('permanentPlace', { required: 'Place is required' })}
                        error={errors.permanentPlace?.message}
                        disabled={sameAsLocalAddress}
                      />
                      <InputText
                        label='Pincode'
                        required
                        placeholder='0'
                        {...register('permanentPincode', { required: 'Pincode is required' })}
                        error={errors.permanentPincode?.message}
                        disabled={sameAsLocalAddress}
                      />
                    </CardContent>
                  </Card>
                </div>

                {/* Photo Upload */}
                <Card>
                  <CardHeader>
                    <CardTitle className="text-sm">Upload Photo</CardTitle>
                  </CardHeader>
                  <CardContent>
                    <div className="flex items-center gap-4">
                      <div className="w-32 h-32 border-2 border-dashed border-gray-300 rounded-lg flex items-center justify-center">
                        <div className="text-center">
                          <Upload className="h-8 w-8 mx-auto text-gray-400" />
                          <p className="text-xs text-gray-500 mt-2">Upload Photo</p>
                        </div>
                      </div>
                      <Button type="button" variant="outline">
                        Choose File
                      </Button>
                    </div>
                  </CardContent>
                </Card>
              </TabsContent>

              {/* Qualification Tab */}
              <TabsContent value="qualification" className="space-y-4">
                <Card>
                  <CardHeader className="flex flex-row items-center justify-between">
                    <CardTitle className="text-sm">CANDIDATE QUALIFICATION DETAILS</CardTitle>
                    <Button type="button" onClick={addQualification} size="sm">
                      <Plus className="h-4 w-4" />
                    </Button>
                  </CardHeader>
                  <CardContent>
                    <div className="space-y-4">
                      {qualifications.map((qual, index) => (
                        <div key={index} className="grid grid-cols-1 md:grid-cols-4 gap-4 p-4 border rounded-lg">
                          <div className="font-medium">Serial No. {qual.serialNo}</div>
                          <InputText
                            placeholder="Course"
                            value={qual.course}
                            onChange={(e) => {
                              const newQuals = [...qualifications];
                              newQuals[index].course = e.target.value;
                              setQualifications(newQuals);
                            }}
                          />
                          <InputText
                            placeholder="Board Name"
                            value={qual.boardName}
                            onChange={(e) => {
                              const newQuals = [...qualifications];
                              newQuals[index].boardName = e.target.value;
                              setQualifications(newQuals);
                            }}
                          />
                          <InputText
                            placeholder="Year Of Passing"
                            value={qual.yearOfPassing}
                            onChange={(e) => {
                              const newQuals = [...qualifications];
                              newQuals[index].yearOfPassing = e.target.value;
                              setQualifications(newQuals);
                            }}
                          />
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              </TabsContent>

              {/* Experience Tab */}
              <TabsContent value="experience" className="space-y-4">
                <Card>
                  <CardHeader className="flex flex-row items-center justify-between">
                    <CardTitle className="text-sm">CANDIDATE EXPERIENCE DETAILS</CardTitle>
                    <Button type="button" onClick={addExperience} size="sm">
                      <Plus className="h-4 w-4" />
                    </Button>
                  </CardHeader>
                  <CardContent>
                    <div className="space-y-4">
                      {experiences.map((exp, index) => (
                        <div key={index} className="grid grid-cols-1 md:grid-cols-6 gap-4 p-4 border rounded-lg">
                          <div className="font-medium">Serial No. {exp.serialNo}</div>
                          <InputText
                            placeholder="Company Name"
                            value={exp.companyName}
                            onChange={(e) => {
                              const newExps = [...experiences];
                              newExps[index].companyName = e.target.value;
                              setExperiences(newExps);
                            }}
                          />
                          <InputText
                            placeholder="Designation"
                            value={exp.designation}
                            onChange={(e) => {
                              const newExps = [...experiences];
                              newExps[index].designation = e.target.value;
                              setExperiences(newExps);
                            }}
                          />
                          <input
                            type="date"
                            placeholder="Date of Join"
                            value={exp.dateOfJoin}
                            onChange={(e) => {
                              const newExps = [...experiences];
                              newExps[index].dateOfJoin = e.target.value;
                              setExperiences(newExps);
                            }}
                            className="w-full px-3 py-2 border rounded-md border-input"
                          />
                          <input
                            type="date"
                            placeholder="Date of Leave"
                            value={exp.dateOfLeave}
                            onChange={(e) => {
                              const newExps = [...experiences];
                              newExps[index].dateOfLeave = e.target.value;
                              setExperiences(newExps);
                            }}
                            className="w-full px-3 py-2 border rounded-md border-input"
                          />
                          <InputText
                            placeholder="Annual Salary"
                            value={exp.annualSalary}
                            onChange={(e) => {
                              const newExps = [...experiences];
                              newExps[index].annualSalary = e.target.value;
                              setExperiences(newExps);
                            }}
                          />
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              </TabsContent>

              {/* Family Tab */}
              <TabsContent value="family" className="space-y-4">
                <Card>
                  <CardHeader className="flex flex-row items-center justify-between">
                    <CardTitle className="text-sm">CANDIDATE FAMILY DETAILS</CardTitle>
                    <Button type="button" onClick={addFamilyMember} size="sm">
                      <Plus className="h-4 w-4" />
                    </Button>
                  </CardHeader>
                  <CardContent>
                    <div className="space-y-4">
                      {familyMembers.map((member, index) => (
                        <div key={index} className="grid grid-cols-1 md:grid-cols-6 gap-4 p-4 border rounded-lg">
                          <div className="font-medium">Serial No. {member.serialNo}</div>
                          <InputText
                            placeholder="Family Member Name"
                            value={member.familyMemberName}
                            onChange={(e) => {
                              const newMembers = [...familyMembers];
                              newMembers[index].familyMemberName = e.target.value;
                              setFamilyMembers(newMembers);
                            }}
                          />
                          <InputText
                            placeholder="Relationship"
                            value={member.relationship}
                            onChange={(e) => {
                              const newMembers = [...familyMembers];
                              newMembers[index].relationship = e.target.value;
                              setFamilyMembers(newMembers);
                            }}
                          />
                          <InputText
                            placeholder="Occupation"
                            value={member.occupation}
                            onChange={(e) => {
                              const newMembers = [...familyMembers];
                              newMembers[index].occupation = e.target.value;
                              setFamilyMembers(newMembers);
                            }}
                          />
                          <InputText
                            placeholder="Work Place"
                            value={member.workPlace}
                            onChange={(e) => {
                              const newMembers = [...familyMembers];
                              newMembers[index].workPlace = e.target.value;
                              setFamilyMembers(newMembers);
                            }}
                          />
                          <InputText
                            placeholder="Age"
                            value={member.age}
                            onChange={(e) => {
                              const newMembers = [...familyMembers];
                              newMembers[index].age = e.target.value;
                              setFamilyMembers(newMembers);
                            }}
                          />
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              </TabsContent>

              {/* Language Tab */}
              <TabsContent value="language" className="space-y-4">
                <Card>
                  <CardHeader className="flex flex-row items-center justify-between">
                    <CardTitle className="text-sm">CANDIDATE LANGUAGE DETAILS</CardTitle>
                    <Button type="button" onClick={addLanguage} size="sm">
                      <Plus className="h-4 w-4" />
                    </Button>
                  </CardHeader>
                  <CardContent>
                    <div className="space-y-4">
                      {languages.map((lang, index) => (
                        <div key={index} className="grid grid-cols-1 md:grid-cols-4 gap-4 p-4 border rounded-lg">
                          <div className="font-medium">Serial No. {lang.serialNo}</div>
                          <InputText
                            placeholder="To Read"
                            value={lang.toRead}
                            onChange={(e) => {
                              const newLangs = [...languages];
                              newLangs[index].toRead = e.target.value;
                              setLanguages(newLangs);
                            }}
                          />
                          <InputText
                            placeholder="To Write"
                            value={lang.toWrite}
                            onChange={(e) => {
                              const newLangs = [...languages];
                              newLangs[index].toWrite = e.target.value;
                              setLanguages(newLangs);
                            }}
                          />
                          <InputText
                            placeholder="To Speak"
                            value={lang.toSpeak}
                            onChange={(e) => {
                              const newLangs = [...languages];
                              newLangs[index].toSpeak = e.target.value;
                              setLanguages(newLangs);
                            }}
                          />
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              </TabsContent>

              {/* Documents Tab */}
              <TabsContent value="documents" className="space-y-4">
                <Card>
                  <CardHeader>
                    <CardTitle className="text-sm">Final Submission</CardTitle>
                    <div className="text-xs text-red-500">
                      <p>* File Must Be Upload jpeg, Png, pdf, Document</p>
                      <p>* File size should be less than 5 MB</p>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <div className="space-y-4">
                      {documents.map((doc, index) => (
                        <div key={index} className="grid grid-cols-1 md:grid-cols-4 gap-4 p-4 border rounded-lg">
                          <div className="font-medium">Sl.No. {doc.serialNo}</div>
                          <Button type="button" variant="outline" className="bg-yellow-400 text-black">
                            Choose File
                          </Button>
                          <div>View</div>
                          <InputText
                            placeholder="Remark"
                            value={doc.remark}
                            onChange={(e) => {
                              const newDocs = [...documents];
                              newDocs[index].remark = e.target.value;
                              setDocuments(newDocs);
                            }}
                          />
                        </div>
                      ))}
                      <Button type="button" onClick={addDocument} size="sm">
                        <Plus className="h-4 w-4" />
                        Add Document
                      </Button>
                    </div>

                    <div className="mt-6 p-4 bg-gray-50 rounded-lg">
                      <div className="space-y-2 text-sm">
                        <p>I consent to the collection and use of my personal data in accordance with the company's privacy policy.</p>
                        <p>I acknowledge that I have received and understood the company's code of conduct.</p>
                        <p>I agree to comply with all company policies and procedures.</p>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              </TabsContent>
            </Tabs>

            {/* Form Actions */}
            <div className='flex justify-center gap-4 pt-6 border-t'>
              <Button type="button" variant="outline" onClick={handleClear}>
                <X className="mr-2 h-4 w-4" />
                Close
              </Button>
              <Button type="submit" disabled={isSubmitting}>
                {isSubmitting ? (
                  <div className='flex items-center'>
                    <RefreshCw className='mr-2 h-4 w-4 animate-spin' />
                    Saving...
                  </div>
                ) : (
                  <div className='flex items-center'>
                    <Save className='mr-2 h-4 w-4' />
                    {editingCandidate ? 'Update & Proceed' : 'Save & Proceed'}
                  </div>
                )}
              </Button>
            </div>
          </form>
        </CollapsibleSection>
          </div>
        )}
      </div>
    </div>
  );
}

interface CandidateTableProps {
  candidates: Candidate[];
  isLoading: boolean;
  onEdit: (candidate: Candidate) => void;
  onDelete: (candidate: Candidate) => void;
}

function CandidateTable({ candidates, isLoading, onEdit, onDelete }: CandidateTableProps) {
  const candidateColumns: ColumnDef<Candidate>[] = [
    {
      id: 'serialNumber',
      header: ({ column }) => <DataTableColumnHeader column={column} title='Sl.No' />,
      cell: ({ row }) => <div className="font-medium">{row.index + 1}</div>,
      enableSorting: false,
    },
    {
      accessorKey: 'firstName',
      header: ({ column }) => <DataTableColumnHeader column={column} title='Candidate Name' />,
      cell: ({ row }) => {
        const candidate = row.original;
        return <div className="font-medium">{`${candidate.firstName} ${candidate.middleName || ''} ${candidate.lastName}`.trim()}</div>;
      }
    },
    {
      accessorKey: 'applicationDate',
      header: ({ column }) => <DataTableColumnHeader column={column} title='Date Of Application' />,
      cell: ({ row }) => <div>{new Date(row.getValue('applicationDate')).toLocaleDateString()}</div>
    },
    {
      accessorKey: 'jobTitle',
      header: ({ column }) => <DataTableColumnHeader column={column} title='Applied Position' />,
      cell: ({ row }) => <div>{row.getValue('jobTitle')}</div>
    },
    {
      accessorKey: 'status',
      header: ({ column }) => <DataTableColumnHeader column={column} title='Status' />,
      cell: ({ row }) => {
        const status = row.getValue('status') as string;
        return (
          <Badge variant={status === 'New' ? 'default' : 'secondary'}>
            {status}
          </Badge>
        );
      }
    },
    {
      id: 'actions',
      header: 'Action',
      cell: ({ row }) => {
        const candidate = row.original;
        return (
          <div className="flex items-center gap-2">
            <Button 
              variant="ghost" 
              size="sm" 
              onClick={() => onEdit(candidate)}
              className="text-blue-600 hover:text-blue-800"
            >
              <Edit className="h-4 w-4" />
            </Button>
            <Button 
              variant="ghost" 
              size="sm" 
              onClick={() => onDelete(candidate)}
              className="text-red-600 hover:text-red-800"
            >
              <Trash2 className="h-4 w-4" />
            </Button>
          </div>
        );
      }
    }
  ];

  return (
    <DataTable
      isLoading={isLoading}
      columns={candidateColumns}
      data={candidates}
      totalItems={candidates.length}
      showViewOptions={true}
    />
  );
}
