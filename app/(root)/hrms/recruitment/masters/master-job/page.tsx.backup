'use client';

import { Heading } from '@/components/layout/heading';
import { DataTable } from '@/components/ui/data-table/data-table';
import { Button } from '@/components/ui/button';
import { CollapsibleSection } from '@/components/ui/form/collapsible-section';
import { FormError } from '@/components/ui/extension/field';
import { InputText } from '@/components/ui/extension/input-text';
import { Badge } from '@/components/ui/badge';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { DataTableColumnHeader } from '@/components/ui/data-table-column-header';
import { DropdownMenu, DropdownMenuContent, DropdownMenuLabel, DropdownMenuTrigger } from '@/components/ui/dropdown-menu';
import type { ColumnDef } from '@tanstack/react-table';
import { Plus, MoreHorizontal, Edit, Trash2, X, Save, RefreshCw } from 'lucide-react';
import React, { useState, useEffect, useRef } from 'react';
import { type SubmitHandler, useForm } from 'react-hook-form';
import { toast } from 'sonner';
import { createLocalCrud, type BaseEntity } from '@/lib/localdb';

interface MasterJob extends BaseEntity {
  jobCode: string;
  jobTitle: string;
  jobLocation: string;
  isActive: boolean;
}

type MasterJobForm = {
  jobCode: string;
  jobTitle: string;
  jobLocation: string;
  isActive: boolean;
};

const jobLocations = [
  'Bangalore',
  'coimbatore',
  'Chennai',
  'Mumbai',
  'Delhi',
  'Hyderabad',
  'Pune',
  'Kolkata'
];

export default function MasterJobPage() {
  const [isFormOpen, setIsFormOpen] = useState(false);
  const [editingId, setEditingId] = useState<number | null>(null);
  const [jobs, setJobs] = useState<MasterJob[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const formRef = useRef<HTMLDivElement>(null);

  const jobDB = createLocalCrud<MasterJob>('master:job');

  const {
    register,
    handleSubmit,
    reset,
    setValue,
    watch,
    formState: { errors, isSubmitting }
  } = useForm<MasterJobForm>({
    mode: 'onChange',
    defaultValues: {
      isActive: true
    }
  });

  const jobLocation = watch('jobLocation');

  // Load data on component mount
  useEffect(() => {
    loadJobs();
  }, []);

  const loadJobs = () => {
    try {
      setJobs(jobDB.list());
    } catch (error) {
      toast.error('Failed to load jobs');
    } finally {
      setIsLoading(false);
    }
  };

  const handleAddClick = () => {
    setIsFormOpen(true);
    setEditingId(null);
    reset({ isActive: true });
    // Scroll to form after state update
    setTimeout(() => {
      formRef.current?.scrollIntoView({
        behavior: 'smooth',
        block: 'end'
      });
    }, 100);
  };

  const handleFormClose = () => {
    setIsFormOpen(false);
    setEditingId(null);
    reset({ isActive: true });
  };

  const onSubmit: SubmitHandler<MasterJobForm> = async (data: MasterJobForm) => {
    try {
      if (editingId) {
        jobDB.update(editingId, data);
        toast.success('Job updated successfully');
      } else {
        jobDB.create(data as Omit<MasterJob, 'id' | 'createdAt'>);
        toast.success('Job created successfully');
      }
      loadJobs();
      handleFormClose();
    } catch (error: any) {
      toast.error(error.message || 'Operation failed');
    }
  };

  const handleEdit = (job: MasterJob) => {
    setEditingId(job.id);
    setValue('jobCode', job.jobCode);
    setValue('jobTitle', job.jobTitle);
    setValue('jobLocation', job.jobLocation);
    setValue('isActive', job.isActive);
    setIsFormOpen(true);
    
    // Scroll to form after state update
    setTimeout(() => {
      formRef.current?.scrollIntoView({
        behavior: 'smooth',
        block: 'end'
      });
    }, 100);
  };

  const handleDelete = (id: number) => {
    try {
      jobDB.remove(id);
      toast.success('Job deleted successfully');
      loadJobs();
    } catch (error: any) {
      toast.error('Failed to delete job');
    }
  };

  return (
    <div className='min-h-screen'>
      <div className='container p-1 space-y-4'>
        {/* Header */}
        <div className='flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'>
          <div className='space-y-1'>
            <Heading
              title='Master Job Management'
              description='Manage job positions and their details'
            />
          </div>
          <Button
            type='button'
            onClick={handleAddClick}
            size='lg'
            className='transition-all duration-200 hover:scale-105 shadow-md hover:shadow-lg w-fit'>
            <Plus className='h-4 w-4' />
            Add Master Job
          </Button>
        </div>

        {/* Data Table Section - Collapsible but default open */}
        <CollapsibleSection
          title='Master Jobs Data'
          description='View, search, and manage all job positions in the system'
          defaultOpen={true}
          variant='default'
          size='lg'
          className='shadow-lg transition-shadow duration-300 hover:shadow-xl'
          headerClassName=''>
          <JobTable jobs={jobs} isLoading={isLoading} onEdit={handleEdit} onDelete={handleDelete} />
        </CollapsibleSection>

        {/* Add Form Section - Conditionally Rendered */}
        {isFormOpen && (
          <div ref={formRef} className='slide-in-from-top-4 animate-in duration-300'>
            <CollapsibleSection
              title={editingId ? 'Update Master Job' : 'Add New Master Job'}
              description='Fill in the details below to create a new job position'
              defaultOpen={true}
              variant='outline'
              size='md'
              className='shadow-lg'
              headerClassName=''>
              <div className='relative'>
                <Button
                  onClick={handleFormClose}
                  variant='ghost'
                  size='sm'
                  className='-top-[4rem] absolute right-12 w-fit border p-2 shadow-md hover:bg-destructive/10'>
                  <X className='h-4 w-4 text-destructive' /> Close
                </Button>
                <form onSubmit={handleSubmit(onSubmit)} className='space-y-6 max-w-full'>
                  {/* Primary Information Section */}
                  <div className='space-y-4'>
                    <div className='grid grid-cols-1 gap-4 lg:grid-cols-2'>
                      <InputText
                        label='Job Code'
                        required
                        id='jobCode'
                        {...register('jobCode', { required: 'Job Code is required' })}
                        error={errors.jobCode?.message}
                        className='transition-colors focus:ring-2 focus:ring-primary/20'
                      />
                      <InputText
                        label='Job Title'
                        required
                        id='jobTitle'
                        {...register('jobTitle', { required: 'Job Title is required' })}
                        error={errors.jobTitle?.message}
                        className='transition-colors focus:ring-2 focus:ring-primary/20'
                      />
                    </div>

                    <div className='grid grid-cols-1 gap-4 lg:grid-cols-2'>
                      <div className='space-y-2'>
                        <label className='text-sm font-medium'>
                          Job Location <span className='text-red-500'>*</span>
                        </label>
                        <Select
                          value={jobLocation || ''}
                          onValueChange={(value) => setValue('jobLocation', value)}
                        >
                          <SelectTrigger className={errors.jobLocation ? 'border-red-500' : ''}>
                            <SelectValue placeholder="--Select--" />
                          </SelectTrigger>
                          <SelectContent>
                            {jobLocations.map((location) => (
                              <SelectItem key={location} value={location}>
                                {location}
                              </SelectItem>
                            ))}
                          </SelectContent>
                        </Select>
                        {!jobLocation && (
                          <input
                            type="hidden"
                            {...register('jobLocation', {
                              required: 'Job Location is required'
                            })}
                          />
                        )}
                        {errors.jobLocation && <FormError>{errors.jobLocation.message}</FormError>}
                      </div>
                      
                      <div className='space-y-2 flex items-center pt-6'>
                        <input
                          type='checkbox'
                          id='isActive'
                          {...register('isActive')}
                          className='text-primary focus:ring-primary border-border mr-2'
                        />
                        <label htmlFor='isActive' className='text-sm font-medium text-foreground'>
                          Active
                        </label>
                      </div>
                    </div>

                    {/* Root Error */}
                    {errors.root && <FormError>{errors.root.message}</FormError>}
                  </div>

                  {/* Action Buttons */}
                  <div className='flex flex-col gap-3 border-t pt-4 sm:flex-row sm:justify-start'>
                    <Button
                      type='button'
                      variant='outline'
                      onClick={handleFormClose}
                      disabled={isSubmitting}
                      className='order-2 sm:order-1 transition-all duration-200 hover:scale-105 w-fit'>
                      Cancel
                    </Button>
                    <Button
                      type='submit'
                      disabled={isSubmitting}
                      className='order-1 sm:order-2 transition-all duration-200 hover:scale-105 w-fit'>
                      {isSubmitting ? (
                        <div className='flex items-center'>
                          <RefreshCw className='mr-2 h-4 w-4 animate-spin' />
                          Saving...
                        </div>
                      ) : (
                        <div className='flex items-center'>
                          <Save className='mr-2 h-4 w-4' />
                          {editingId ? 'Update Master Job' : 'Save Master Job'}
                        </div>
                      )}
                    </Button>
                  </div>
                </form>
              </div>
            </CollapsibleSection>
          </div>
        )}
      </div>
    </div>
  );
}

interface JobTableProps {
  jobs: MasterJob[];
  isLoading: boolean;
  onEdit: (job: MasterJob) => void;
  onDelete: (id: number) => void;
}

function JobTable({ jobs, isLoading, onEdit, onDelete }: JobTableProps) {
  const jobColumns: ColumnDef<MasterJob>[] = [
    {
      accessorKey: 'jobCode',
      header: ({ column }) => <DataTableColumnHeader column={column} title='Job Code' />,
      cell: ({ row }) => <div className="font-medium">{row.getValue('jobCode')}</div>
    },
    {
      accessorKey: 'jobTitle',
      header: ({ column }) => <DataTableColumnHeader column={column} title='Job Title' />,
      cell: ({ row }) => <div>{row.getValue('jobTitle')}</div>
    },
    {
      accessorKey: 'jobLocation',
      header: ({ column }) => <DataTableColumnHeader column={column} title='Job Location' />,
      cell: ({ row }) => <div>{row.getValue('jobLocation')}</div>
    },
    {
      accessorKey: 'isActive',
      header: ({ column }) => <DataTableColumnHeader column={column} title='Status' />,
      cell: ({ row }) => {
        const isActive = row.getValue('isActive') as boolean;
        return (
          <Badge variant={isActive ? 'default' : 'secondary'}>
            {isActive ? 'Active' : 'Inactive'}
          </Badge>
        );
      }
    },
    {
      id: 'actions',
      header: 'Actions',
      cell: ({ row }) => {
        const job = row.original;
        return (
          <DropdownMenu>
            <DropdownMenuTrigger asChild>
              <Button variant="ghost" className="h-8 w-8 p-0">
                <MoreHorizontal className="h-4 w-4" />
              </Button>
            </DropdownMenuTrigger>
            <DropdownMenuContent align="end">
              <DropdownMenuLabel>Actions</DropdownMenuLabel>
              <Button
                variant="ghost"
                size="sm"
                onClick={() => onEdit(job)}
                className="w-full justify-start"
              >
                <Edit className="mr-2 h-4 w-4" />
                Edit
              </Button>
              <Button
                variant="ghost"
                size="sm"
                onClick={() => onDelete(job.id)}
                className="w-full justify-start text-red-600 hover:text-red-900"
              >
                <Trash2 className="mr-2 h-4 w-4" />
                Delete
              </Button>
            </DropdownMenuContent>
          </DropdownMenu>
        );
      }
    }
  ];

  return (
    <DataTable
      isLoading={isLoading}
      columns={jobColumns}
      data={jobs}
      totalItems={jobs.length}
      showViewOptions={true}
    />
  );
}