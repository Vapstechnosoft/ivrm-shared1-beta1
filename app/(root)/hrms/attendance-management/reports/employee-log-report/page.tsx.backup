'use client';

import { Heading } from '@/components/layout/heading';
import { Button } from '@/components/ui/button';
import { CollapsibleSection } from '@/components/ui/form/collapsible-section';
import { DataTable } from '@/components/ui/data-table/data-table';
import { DataTableColumnHeader } from '@/components/ui/data-table-column-header';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { InputText } from '@/components/ui/extension/input-text';
import { Checkbox } from '@/components/ui/checkbox';
import type { ColumnDef } from '@tanstack/react-table';
import React, { useMemo, useState } from 'react';
import { createLocalCrud, type BaseEntity } from '@/lib/localdb';
import { RefreshCw, FileDown, Printer } from 'lucide-react';

interface LogRow extends BaseEntity {
  type: string;
  department: string;
  designation: string;
  employeeCode: string;
  employeeName: string;
  date: string;
  punchTime?: string;
  lateIn?: string;
  earlyOut?: string;
}

export default function EmployeeLogReportPage() {
  const db = createLocalCrud<LogRow>('attendance:log');

  const [type, setType] = useState<string>('');
  const [department, setDepartment] = useState<string>('');
  const [designation, setDesignation] = useState<string>('');
  const [allOrIndividual, setAllOrIndividual] = useState<'All' | 'Individual'>('All');
  const [codeOrName, setCodeOrName] = useState<'Code' | 'Name'>('Code');
  const [query, setQuery] = useState<string>('');
  const [dateMode, setDateMode] = useState<'Date' | 'Monthly' | 'From Date'>('Date');
  const [date, setDate] = useState<string>('');
  const [month, setMonth] = useState<string>('');
  const [fromDate, setFromDate] = useState<string>('');
  const [toDate, setToDate] = useState<string>('');
  const [metric, setMetric] = useState<'Punch Time' | 'Late In' | 'Early Out'>('Punch Time');

  const data = useMemo(() => db.list(), []);

  const filtered = useMemo(() => {
    return data.filter(r => {
      const okType = type ? r.type === type : true;
      const okDept = department ? r.department === department : true;
      const okDesg = designation ? r.designation === designation : true;
      const okQuery = allOrIndividual === 'Individual' && query
        ? (codeOrName === 'Code' ? r.employeeCode.includes(query) : r.employeeName.toLowerCase().includes(query.toLowerCase()))
        : true;
      const okDate = dateMode === 'Date' ? (date ? r.date === date : true) : dateMode === 'Monthly' ? (month ? r.date.startsWith(month) : true) : (fromDate ? new Date(r.date) >= new Date(fromDate) : true) && (toDate ? new Date(r.date) <= new Date(toDate) : true);
      const okMetric = metric === 'Punch Time' ? r.punchTime : metric === 'Late In' ? r.lateIn : r.earlyOut;
      return okType && okDept && okDesg && okQuery && okDate && okMetric;
    });
  }, [data, type, department, designation, allOrIndividual, codeOrName, query, dateMode, date, month, fromDate, toDate, metric]);

  const columns: ColumnDef<LogRow>[] = [
    { id: 'sl', header: ({ column }) => <DataTableColumnHeader column={column} title='SL.NO' />, cell: ({ row }) => <div className='font-medium'>{row.index + 1}</div>, enableSorting: false },
    { accessorKey: 'employeeName', header: ({ column }) => <DataTableColumnHeader column={column} title='Employee Name' /> },
    { accessorKey: 'employeeCode', header: ({ column }) => <DataTableColumnHeader column={column} title='Code' /> },
    { accessorKey: 'date', header: ({ column }) => <DataTableColumnHeader column={column} title='Date' /> },
    { accessorKey: 'punchTime', header: ({ column }) => <DataTableColumnHeader column={column} title='Punch Time' /> },
    { accessorKey: 'lateIn', header: ({ column }) => <DataTableColumnHeader column={column} title='Late In' /> },
    { accessorKey: 'earlyOut', header: ({ column }) => <DataTableColumnHeader column={column} title='Early Out' /> },
    { accessorKey: 'department', header: ({ column }) => <DataTableColumnHeader column={column} title='Department' /> },
    { accessorKey: 'designation', header: ({ column }) => <DataTableColumnHeader column={column} title='Designation' /> },
  ];

  const handleReport = () => {};
  const handleExport = () => {};
  const handlePrint = () => window.print();

  return (
    <div className='min-h-screen'>
      <div className='container p-1 space-y-4'>
        <div className='flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'>
          <div className='space-y-1'>
            <Heading title='Employee Log Report' description='' />
          </div>
        </div>

        <CollapsibleSection title='' description='' defaultOpen={true} variant='default' size='lg' className='shadow-lg transition-shadow duration-300 hover:shadow-xl'>
          <div className='grid grid-cols-1 md:grid-cols-12 gap-4'>
            <div className='md:col-span-3'>
              <label className='text-sm font-medium'>Type</label>
              <Select onValueChange={setType}><SelectTrigger><SelectValue placeholder='Type' /></SelectTrigger><SelectContent><SelectItem value='Permanent'>Permanent</SelectItem><SelectItem value='Contract'>Contract</SelectItem></SelectContent></Select>
            </div>
            <div className='md:col-span-3'>
              <label className='text-sm font-medium'>Department</label>
              <Select onValueChange={setDepartment}><SelectTrigger><SelectValue placeholder='Department' /></SelectTrigger><SelectContent>{[...new Set(data.map(d=>d.department))].map(v=> <SelectItem key={v} value={v}>{v}</SelectItem>)}</SelectContent></Select>
            </div>
            <div className='md:col-span-3'>
              <label className='text-sm font-medium'>Designation</label>
              <Select onValueChange={setDesignation}><SelectTrigger><SelectValue placeholder='Designation' /></SelectTrigger><SelectContent>{[...new Set(data.map(d=>d.designation))].map(v=> <SelectItem key={v} value={v}>{v}</SelectItem>)}</SelectContent></Select>
            </div>

            <div className='md:col-span-3 flex gap-4 items-center pt-2'>
              <label className='flex items-center gap-2 text-sm'><Checkbox checked={allOrIndividual==='All'} onCheckedChange={()=>setAllOrIndividual('All')} /> All</label>
              <label className='flex items-center gap-2 text-sm'><Checkbox checked={allOrIndividual==='Individual'} onCheckedChange={()=>setAllOrIndividual('Individual')} /> Individual</label>
            </div>

            <div className='md:col-span-6 flex gap-4'>
              <label className='flex items-center gap-2 text-sm'><Checkbox checked={codeOrName==='Code'} onCheckedChange={()=>setCodeOrName('Code')} /> Code</label>
              <label className='flex items-center gap-2 text-sm'><Checkbox checked={codeOrName==='Name'} onCheckedChange={()=>setCodeOrName('Name')} /> Name</label>
              <InputText placeholder={codeOrName==='Code'?'Code':'Name'} value={query} onChange={(e)=>setQuery(e.target.value)} />
            </div>

            <div className='md:col-span-12 flex gap-4 items-center'>
              <label className='flex items-center gap-2 text-sm'><Checkbox checked={dateMode==='Date'} onCheckedChange={()=>setDateMode('Date')} /> Date</label>
              <InputText type='date' value={date} onChange={(e)=>setDate(e.target.value)} />
              <label className='flex items-center gap-2 text-sm'><Checkbox checked={dateMode==='Monthly'} onCheckedChange={()=>setDateMode('Monthly')} /> Monthly</label>
              <Select onValueChange={setMonth}><SelectTrigger className='w-40'><SelectValue placeholder='--Select--' /></SelectTrigger><SelectContent>{['01','02','03','04','05','06','07','08','09','10','11','12'].map(m=> <SelectItem key={m} value={m}>{m}</SelectItem>)}</SelectContent></Select>
              <label className='flex items-center gap-2 text-sm'><Checkbox checked={dateMode==='From Date'} onCheckedChange={()=>setDateMode('From Date')} /> From Date</label>
              <InputText type='date' value={fromDate} onChange={(e)=>setFromDate(e.target.value)} />
              <span>To Date :</span>
              <InputText type='date' value={toDate} onChange={(e)=>setToDate(e.target.value)} />
            </div>

            <div className='md:col-span-3'>
              <label className='text-sm font-medium'>Mode</label>
              <Select onValueChange={(v)=>setMetric(v as any)}><SelectTrigger><SelectValue placeholder='Mode' /></SelectTrigger><SelectContent><SelectItem value='Punch Time'>Punch Time</SelectItem><SelectItem value='Late In'>Late In</SelectItem><SelectItem value='Early Out'>Early Out</SelectItem></SelectContent></Select>
            </div>
            <div className='md:col-span-9 flex gap-2 items-end'>
              <Button onClick={handleReport}><RefreshCw className='h-4 w-4 mr-2' /> Report</Button>
              <Button variant='outline' onClick={handleExport}><FileDown className='h-4 w-4 mr-2' /> Export to Excel</Button>
              <Button variant='outline' onClick={handlePrint}><Printer className='h-4 w-4 mr-2' /> Print</Button>
            </div>
          </div>
        </CollapsibleSection>

        <CollapsibleSection title='Employee Log Report' description='' defaultOpen={true} variant='default' size='lg' className='shadow-lg transition-shadow duration-300 hover:shadow-xl'>
          <DataTable isLoading={false} columns={columns} data={filtered} totalItems={filtered.length} showViewOptions />
        </CollapsibleSection>
      </div>
    </div>
  );
}
